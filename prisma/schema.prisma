// Tek doğruluk kaynağı: model, alan, indeks ve ilişki burada; ilkeler docs/data.md'dedir.
// Prisma 7: üretilen istemci `node_modules`'a değil `output` yoluna yazılır (Git dışı);
// bağlantı adresi prisma.config.ts'tedir, istemci driver adapter ile kurulur (src/server/db.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Kurum yapısı (üniversite → fakülte → bölüm) sistem yöneticisinindir.
model University {
  id                  String   @id @default(uuid(7))
  name                String   @unique
  shortName           String   @unique
  /// Öğrenci e-postası alan adları: üniversiteyi doğrular, bölümü doğrulamaz (docs/architecture.md).
  studentEmailDomains String[]
  /// Personel (akademisyen) e-postası alan adları.
  staffEmailDomains   String[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  faculties Faculty[]
}

model Faculty {
  id           String   @id @default(uuid(7))
  universityId String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  university  University   @relation(fields: [universityId], references: [id], onDelete: Restrict)
  departments Department[]
  adminGrants AdminGrant[]

  @@unique([universityId, name])
}

model Department {
  id        String   @id @default(uuid(7))
  facultyId String
  name      String
  /// Kısa kod (örn. YBS); fakülte içinde benzersiz.
  code      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faculty             Faculty              @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  memberships         Membership[]
  adminGrants         AdminGrant[]
  graduationDocuments GraduationDocument[]

  @@unique([facultyId, code])
  @@unique([facultyId, name])
}

// ---------------------------------------------------------------------------------------------
// Kimlik, üyelik, yetki ve işlem kaydı (P1-01). Prisma'nın ifade edemediği kısıtlar (kısmi benzersizlik,
// CHECK, yalnız-ekleme tetikleyicisi) ham SQL olarak 20261107203050_identity_membership_admin
// migration'ındadır; sözleşme docs/data.md "Temel değişmezler"dedir.
// ---------------------------------------------------------------------------------------------

/// Üyelik rolü. Mentorluk bir rol değil, etkin `MentorProfile`'dır; yönetici yetkisi `AdminGrant`'tır.
enum MembershipRole {
  STUDENT
  ALUMNI
  ACADEMIC
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// Doğrulama yolu (docs/architecture.md "Kimlik ve doğrulama"). Rol ile uyumu veritabanı kısıtıdır:
/// alan adı ile mezun doğrulanamaz, mezun yalnız belge ya da yönetici ile doğrulanır.
enum VerificationMethod {
  STUDENT_EMAIL
  STAFF_EMAIL
  GRADUATION_DOCUMENT
  ADMIN
}

enum AdminScope {
  SYSTEM
  FACULTY
  DEPARTMENT
}

enum MeetingMode {
  ONLINE
  IN_PERSON
}

/// Better Auth kullanıcı tablosu (P1-02 Better Auth'u buna bağlar; `Session`/`Account`/`Verification` orada).
/// Askıya alma alanları admin eklentisinindir: oturumlar düşer, giriş engellenir. Yetki kararı
/// ASLA bu tablodaki bir "rol" alanından verilmez; yetki `Membership` ve `AdminGrant`'tan gelir.
model User {
  id            String    @id @default(uuid(7))
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  phone         String?
  lastSeenAt    DateTime?
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  /// Better Auth admin eklentisinin alanı (eklenti şemasında zorunlu). YETKİ KARARINDA ASLA KULLANILMAZ:
  /// yetki yalnız `Membership` ve `AdminGrant`'tan gelir (davranış testi: `role = 'admin'` yetki vermez).
  role          String?
  /// Hesap silindi (P1-03): satır kalır (işlem kaydı ve ilişkiler için), kişisel alanlar temizlenir.
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships                 Membership[]         @relation("MembershipOwner")
  verifiedMemberships         Membership[]         @relation("MembershipVerifier")
  adminGrants                 AdminGrant[]         @relation("AdminGrantOwner")
  grantedAdminGrants          AdminGrant[]         @relation("AdminGrantGranter")
  revokedAdminGrants          AdminGrant[]         @relation("AdminGrantRevoker")
  mentorProfile               MentorProfile?
  adminAuditLogs              AdminAuditLog[]
  sessions                    Session[]
  accounts                    Account[]
  graduationDocuments         GraduationDocument[] @relation("GraduationDocumentOwner")
  reviewedGraduationDocuments GraduationDocument[] @relation("GraduationDocumentReviewer")
  emailLogs                   EmailLog[]
}

/// Üyelik = kullanıcı × bölüm × rol. Rol geçişinde eski satır `endedAt` ile kapanır, yenisi eklenir;
/// geçmiş korunur. İçerik ve puan `userId`'ye bağlanır, üyeliğe değil (bu yüzden geçişten etkilenmez).
model Membership {
  id                 String             @id @default(uuid(7))
  userId             String
  departmentId       String
  role               MembershipRole
  /// Giriş yılı (öğrenci). Sınıf saklanmaz; `rules/classYear` hesaplar.
  entryYear          Int?
  /// Hazırlık/uzatma düzeltmesi (kullanıcı girer): etkin sınıf = hesaplanan + düzeltme.
  classOffset        Int                @default(0)
  graduationYear     Int?
  verificationStatus VerificationStatus @default(PENDING)
  verificationMethod VerificationMethod
  verifiedAt         DateTime?
  verifiedById       String?
  /// Boşsa üyelik etkindir. Aynı kullanıcı+bölüm+rolde en fazla bir etkin satır olabilir.
  endedAt            DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user       User       @relation("MembershipOwner", fields: [userId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  verifiedBy User?      @relation("MembershipVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([departmentId, verificationStatus])
}

/// Kapsamlı yönetici yetkisi. `SYSTEM`: her şey; `FACULTY`: fakülte ve altındaki bölümler;
/// `DEPARTMENT`: yalnız o bölüm. Kaldırılan yetki silinmez, `revokedAt` ile kapanır.
model AdminGrant {
  id           String     @id @default(uuid(7))
  userId       String
  scope        AdminScope
  facultyId    String?
  departmentId String?
  grantedById  String
  revokedAt    DateTime?
  revokedById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user       User        @relation("AdminGrantOwner", fields: [userId], references: [id], onDelete: Restrict)
  faculty    Faculty?    @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  grantedBy  User        @relation("AdminGrantGranter", fields: [grantedById], references: [id], onDelete: Restrict)
  revokedBy  User?       @relation("AdminGrantRevoker", fields: [revokedById], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([facultyId])
  @@index([departmentId])
}

/// Mentorluk = etkin profil. Kapasite ve görüşme süresi mentorun kararıdır; bu yüzden varsayılan yoktur.
model MentorProfile {
  userId               String        @id
  isActive             Boolean       @default(false)
  monthlyCapacity      Int
  /// 15, 20 ya da 30 dakika (veritabanı kısıtı).
  sessionMinutes       Int
  meetingModes         MeetingMode[]
  inPersonNote         String?
  /// “Müsait değilim”: bu tarihe kadar yeni talep alınmaz.
  pausedUntil          DateTime?
  cvReviewEnabled      Boolean       @default(false)
  cvReviewMonthlyLimit Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

/// Yönetici işlem kaydı (D6). YALNIZ EKLENİR: veritabanı tetikleyicisi güncelleme/silme/TRUNCATE'i
/// reddeder. `metadata` ve `reason` kişisel veri içermez (yalnız kimlikler); `recordAdminAction` doğrular.
model AdminAuditLog {
  id         String   @id @default(uuid(7))
  actorId    String
  action     String
  targetType String
  targetId   String
  reason     String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}

// ---------------------------------------------------------------------------------------------
// Kimlik doğrulama (P1-02 sözleşmesi). Better Auth 1.7 Prisma adaptörünün beklediği alanlar
// (`getAuthTables`: user + admin eklentisi, session, account, verification, rateLimit); sözleşme
// docs/data.md. Ham SQL kısıtlar 20261107205405_auth_contract migration'ındadır.
// ---------------------------------------------------------------------------------------------

/// Veritabanı oturumu. Çerez yalnız jetonu taşır (httpOnly, secure, sameSite=lax). Askıya alma ve hesap
/// silmede oturumlar silinir. `impersonatedBy` admin eklentisinin alanıdır; "başka kullanıcı gibi giriş"
/// KAPALIDIR, bu sütun hep boş kalır.
model Session {
  id             String   @id @default(uuid(7))
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  /// Süresi geçmiş oturum temizliği için (indeks migration'da oluşturulur).
  @@index([expiresAt])
}

/// Dış sağlayıcı bağlantısı (LinkedIn). Giriş parolasızdır; `password` Better Auth şemasında bulunur ama
/// KULLANILMAZ. Jetonlar sağlayıcı tarafına aittir; servis adımı onları şifreli saklar (decisions.md).
model Account {
  id                    String    @id @default(uuid(7))
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

/// Süreli, tek kullanımlık doğrulama kayıtları (e-posta bağlantısı, e-posta değiştirme).
model Verification {
  id         String   @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

/// Better Auth hız sınırı deposu (`rateLimit.storage = "database"`): süreçler arasında ve yeniden
/// başlatmada korunur. `lastRequest` milisaniye damgasıdır.
model RateLimit {
  id          String @id @default(uuid(7))
  key         String @unique
  count       Int
  lastRequest BigInt
}

enum GraduationDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Mezun belgesi (e-Devlet barkodlu PDF) doğrulama kuyruğu. Belge dosyası YALNIZ karar verilene kadar
/// durur: karar anında `storageKey` null olur ve dosya silinir (veritabanı kısıtı). Kuyruk bölümün
/// yöneticisine görünür (`departmentId`). Hedef üyelik (kullanıcı + bölüm, `ALUMNI`) `userId` ve
/// `departmentId` ile bulunur; `Membership`'e yabancı anahtar YOKTUR (şema değişmezi).
model GraduationDocument {
  id             String                   @id @default(uuid(7))
  userId         String
  departmentId   String
  /// Kullanıcının beyan ettiği mezuniyet yılı; onayda `ALUMNI` üyeliğine yazılır.
  graduationYear Int
  /// `graduation/<userId>/<uuid>.pdf`; karar verilmiş satırda null.
  storageKey     String?
  status         GraduationDocumentStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  rejectReason   String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  user       User       @relation("GraduationDocumentOwner", fields: [userId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  reviewedBy User?      @relation("GraduationDocumentReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([departmentId, status, createdAt])
  @@index([userId])
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

/// Giden e-posta kaydı (giden kutusu). GÖVDE ve alıcı adresi SAKLANMAZ: yalnız şablon, alıcı kimliği ve
/// durum. `idempotencyKey` aynı e-postanın ikinci kez gönderilmesini engeller. Saklama 6 ay (docs/data.md).
model EmailLog {
  id              String      @id @default(uuid(7))
  idempotencyKey  String      @unique
  template        String
  /// Kayıtsız adrese giden giriş bağlantısında boştur (kayıtlı olup olmadığı sızmasın diye ayrım yok).
  recipientUserId String?
  status          EmailStatus @default(QUEUED)
  attempts        Int         @default(0)
  errorCode       String?
  sentAt          DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  recipientUser User? @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([recipientUserId])
}
