// Tek doğruluk kaynağı: model, alan, indeks ve ilişki burada; ilkeler docs/data.md'dedir.
// Prisma 7: üretilen istemci `node_modules`'a değil `output` yoluna yazılır (Git dışı);
// bağlantı adresi prisma.config.ts'tedir, istemci driver adapter ile kurulur (src/server/db.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Kurum yapısı (üniversite → fakülte → bölüm) sistem yöneticisinindir.
model University {
  id                     String   @id @default(uuid(7))
  name                   String   @unique
  shortName              String   @unique
  /// Öğrenci e-postası alan adları: üniversiteyi doğrular, bölümü doğrulamaz (docs/architecture.md).
  studentEmailDomains    String[]
  /// Personel (akademisyen) e-postası alan adları.
  staffEmailDomains      String[]
  /// LinkedIn kurum kimliği bilinmiyorsa boş bırakılır; bağlantı kurumsuz da oluşturulur.
  linkedinOrganizationId String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  faculties Faculty[]
}

model Faculty {
  id           String   @id @default(uuid(7))
  universityId String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  university  University   @relation(fields: [universityId], references: [id], onDelete: Restrict)
  departments Department[]
  adminGrants AdminGrant[]

  @@unique([universityId, name])
}

model Department {
  id        String   @id @default(uuid(7))
  facultyId String
  name      String
  /// Kısa kod (örn. YBS); fakülte içinde benzersiz.
  code      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faculty             Faculty                 @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  memberships         Membership[]
  adminGrants         AdminGrant[]
  experiences         Experience[]
  faqRequests         FaqRequest[]
  faqItems            FaqItem[]
  graduationDocuments GraduationDocument[]
  events              Event[]
  jobPostings         JobPosting[]
  jobPostingTargets   JobPostingDepartment[]
  referralClaims      ReferralClaim[]
  awardCycles         AwardCycle[]
  awards              Award[]
  alumniStories       AlumniStory[]
  monthlyAlumni       MonthlyAlumnus[]
  courses             Course[]
  campusEventTargets  CampusEventDepartment[]

  @@unique([facultyId, code])
  @@unique([facultyId, name])
}

// ---------------------------------------------------------------------------------------------
// Kimlik, üyelik, yetki ve işlem kaydı (P1-01). Prisma'nın ifade edemediği kısıtlar (kısmi benzersizlik,
// CHECK, yalnız-ekleme tetikleyicisi) ham SQL olarak 20261107203050_identity_membership_admin
// migration'ındadır; sözleşme docs/data.md "Temel değişmezler"dedir.
// ---------------------------------------------------------------------------------------------

/// Üyelik rolü. Mentorluk bir rol değil, etkin `MentorProfile`'dır; yönetici yetkisi `AdminGrant`'tır.
enum MembershipRole {
  STUDENT
  ALUMNI
  ACADEMIC
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// Doğrulama yolu (docs/architecture.md "Kimlik ve doğrulama"). Rol ile uyumu veritabanı kısıtıdır:
/// alan adı ile mezun doğrulanamaz, mezun yalnız belge ya da yönetici ile doğrulanır.
enum VerificationMethod {
  STUDENT_EMAIL
  STAFF_EMAIL
  GRADUATION_DOCUMENT
  ADMIN
}

enum AdminScope {
  SYSTEM
  FACULTY
  DEPARTMENT
}

enum MeetingMode {
  ONLINE
  IN_PERSON
}

/// Better Auth kullanıcı tablosu (P1-02 Better Auth'u buna bağlar; `Session`/`Account`/`Verification` orada).
/// Askıya alma alanları admin eklentisinindir: oturumlar düşer, giriş engellenir. Yetki kararı
/// ASLA bu tablodaki bir "rol" alanından verilmez; yetki `Membership` ve `AdminGrant`'tan gelir.
model User {
  id            String    @id @default(uuid(7))
  name          String
  nameSearch    String?   @default(dbgenerated())
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  phone         String?
  lastSeenAt    DateTime?
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  /// Better Auth admin eklentisinin alanı (eklenti şemasında zorunlu). YETKİ KARARINDA ASLA KULLANILMAZ:
  /// yetki yalnız `Membership` ve `AdminGrant`'tan gelir (davranış testi: `role = 'admin'` yetki vermez).
  role          String?
  /// Hesap silindi (P1-03): satır kalır (işlem kaydı ve ilişkiler için), kişisel alanlar temizlenir.
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships                 Membership[]             @relation("MembershipOwner")
  verifiedMemberships         Membership[]             @relation("MembershipVerifier")
  adminGrants                 AdminGrant[]             @relation("AdminGrantOwner")
  grantedAdminGrants          AdminGrant[]             @relation("AdminGrantGranter")
  revokedAdminGrants          AdminGrant[]             @relation("AdminGrantRevoker")
  mentorProfile               MentorProfile?
  adminAuditLogs              AdminAuditLog[]
  sessions                    Session[]
  accounts                    Account[]
  graduationDocuments         GraduationDocument[]     @relation("GraduationDocumentOwner")
  reviewedGraduationDocuments GraduationDocument[]     @relation("GraduationDocumentReviewer")
  emailLogs                   EmailLog[]
  notificationPreferences     NotificationPreference[]
  notificationIntents         NotificationIntent[]
  notificationActions         NotificationAction[]
  jobMatches                  JobMatch[]
  jobMatchDigests             JobMatchDigest[]
  sessionFeedbacks            SessionFeedback[]
  consents                    Consent[]
  fieldVisibilities           FieldVisibility[]
  sentContactRequests         ContactRequest[]         @relation("ContactRequestRequester")
  receivedContactRequests     ContactRequest[]         @relation("ContactRequestTarget")
  profile                     Profile?
  cvUploads                   CvUpload[]
  requestedCvReviews          CvReviewRequest[]        @relation("CvReviewStudent")
  receivedCvReviews           CvReviewRequest[]        @relation("CvReviewMentor")
  educations                  Education[]
  positions                   Position[]
  languages                   Language[]
  certifications              Certification[]
  skills                      UserSkill[]
  experienceInvitations       ExperienceInvitation[]
  companyFollows              CompanyFollow[]
  courseMarks                 AlumniCourseMark[]

  experiences               Experience[]               @relation("ExperienceAuthor")
  moderatedExperiences      Experience[]               @relation("ExperienceModerator")
  reports                   Report[]                   @relation("ReportReporter")
  events                    Event[]
  availabilityRules         AvailabilityRule[]
  mentorAppointments        Appointment[]              @relation("AppointmentMentor")
  menteeAppointments        Appointment[]              @relation("AppointmentMentee")
  reviewedReports           Report[]                   @relation("ReportReviewer")
  cancelledAppointments     Appointment[]              @relation("AppointmentCanceller")
  pointEntries              PointEntry[]               @relation("PointOwner")
  counterpartPoints         PointEntry[]               @relation("PointCounterpart")
  suspicionFlags            SuspicionFlag[]
  badges                    UserBadge[]
  faqRequests               FaqRequest[]               @relation("FaqAsker")
  faqAnswers                FaqAnswer[]
  jobPostings               JobPosting[]               @relation("JobPostingAuthor")
  moderatedJobPostings      JobPosting[]               @relation("JobPostingModerator")
  endedJobPostings          JobPosting[]               @relation("JobPostingEnder")
  jobPostingReports         JobPostingReport[]         @relation("JobPostingReporter")
  reviewedJobReports        JobPostingReport[]         @relation("JobPostingReportReviewer")
  givenReferrals            ReferralClaim[]            @relation("ReferralAlumnus")
  receivedReferrals         ReferralClaim[]            @relation("ReferralStudent")
  reviewedReferrals         ReferralClaim[]            @relation("ReferralReviewer")
  reviewedAcceptances       ReferralClaim[]            @relation("ReferralAcceptanceReviewer")
  awardCandidates           AwardCandidate[]
  awards                    Award[]
  awardPublicationDecisions AwardPublicationDecision[]
  alumniStories             AlumniStory[]
  storyConsentDecisions     StoryConsentDecision[]
  campusEventsCreated       CampusEvent[]              @relation("CampusEventCreator")
  campusEventsReviewed      CampusEvent[]              @relation("CampusEventReviewer")
  campusEventRegistrations  CampusEventRegistration[]
  campusEventAttendances    EventAttendance[]

  @@index([nameSearch(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_nameSearch_trgm")
}

enum CampusEventStatus {
  PENDING
  PUBLISHED
  REJECTED
  CANCELLED
}

model CampusEvent {
  id            String                    @id @default(uuid(7))
  title         String
  description   String
  location      String
  startsAt      DateTime
  endsAt        DateTime
  capacity      Int
  status        CampusEventStatus         @default(PENDING)
  createdById   String?
  reviewedById  String?
  reviewReason  String?
  reviewedAt    DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  createdBy     User?                     @relation("CampusEventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy    User?                     @relation("CampusEventReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  departments   CampusEventDepartment[]
  registrations CampusEventRegistration[]
  attendances   EventAttendance[]

  @@index([status, startsAt])
}

model CampusEventDepartment {
  eventId      String
  departmentId String
  event        CampusEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([eventId, departmentId])
  @@index([departmentId])
}

model CampusEventRegistration {
  eventId   String
  userId    String
  createdAt DateTime    @default(now())
  event     CampusEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId, createdAt])
}

model EventAttendance {
  id            String      @id @default(uuid(7))
  eventId       String
  userId        String
  attendedAt    DateTime    @default(now())
  networkDigest String?
  event         CampusEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, attendedAt])
  @@index([eventId, networkDigest])
  @@index([userId, attendedAt])
}

enum AlumniStoryStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
}

/// Metin her değiştiğinde yeniden moderasyona gider; yayın rızası geri alınınca görünmez.
model AlumniStory {
  id                   String                 @id @default(uuid(7))
  userId               String
  departmentId         String
  body                 String
  status               AlumniStoryStatus      @default(DRAFT)
  publicConsentAt      DateTime?
  publicConsentVersion String?
  moderationReason     String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  submittedAt          DateTime?
  moderatedAt          DateTime?
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  department           Department             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  selections           MonthlyAlumnus[]
  consentDecisions     StoryConsentDecision[]

  @@unique([userId, departmentId])
  @@unique([id, departmentId])
  @@index([departmentId, status])
}

/// Rıza kanıtı saklanır; hikâye silindiğinde ilişki kaldırılır, kişi anonimleştirilir.
model StoryConsentDecision {
  id        String       @id @default(uuid(7))
  storyId   String?
  userId    String
  version   String
  granted   Boolean
  createdAt DateTime     @default(now())
  story     AlumniStory? @relation(fields: [storyId], references: [id], onDelete: SetNull)
  user      User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

/// Bölüm ve İstanbul takvim ayı başına tek seçim; güncel ay okuma anında da denetlenir.
model MonthlyAlumnus {
  id           String      @id @default(uuid(7))
  departmentId String
  storyId      String
  month        String
  chosenAt     DateTime    @default(now())
  active       Boolean     @default(false)
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  story        AlumniStory @relation(fields: [storyId, departmentId], references: [id, departmentId], onDelete: Cascade)

  @@unique([departmentId, month])
  @@index([month, active])
}

enum AwardKind {
  YEAR_ALUMNI
}

/// Akademik yılın başlangıç yılı; tören tarihi İstanbul gününün başlangıcı olarak saklanır.
model AwardCycle {
  id           String           @id @default(uuid(7))
  departmentId String
  year         Int
  ceremonyAt   DateTime
  frozenAt     DateTime?
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  candidates   AwardCandidate[]
  awards       Award[]

  @@unique([departmentId, year])
}

/// Dondurulmuş adayın hesaplanmış değerleri; kullanıcı silinirken silinir.
model AwardCandidate {
  id              String     @id @default(uuid(7))
  cycleId         String
  userId          String
  points          Int
  experienceCount Int
  meetingCount    Int
  breakdown       Json
  cycle           AwardCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cycleId, userId])
}

model Award {
  id                   String                     @id @default(uuid(7))
  kind                 AwardKind                  @default(YEAR_ALUMNI)
  cycleId              String
  departmentId         String
  userId               String
  year                 Int
  verificationCode     String                     @unique
  publicConsentAt      DateTime?
  publicConsentVersion String?
  createdAt            DateTime                   @default(now())
  cycle                AwardCycle                 @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  department           Department                 @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  user                 User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicationDecisions AwardPublicationDecision[]

  @@unique([kind, departmentId, year])
  @@index([userId])
}

/// Sürümlü açık rıza geçmişi; ödül silinince rıza kanıtı anonimleştirilmiş hesaba bağlı kalır.
model AwardPublicationDecision {
  id        String   @id @default(uuid(7))
  awardId   String?
  userId    String
  version   String
  granted   Boolean
  createdAt DateTime @default(now())
  award     Award?   @relation(fields: [awardId], references: [id], onDelete: SetNull)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([awardId, createdAt, id])
  @@index([userId, createdAt])
}

enum NotificationIntentStatus {
  PENDING
  FAILED
}

/// İşlemle aynı anda kaydedilen bildirim niyeti. Davet adresi yalnız geçici şifreli yükte tutulur.
/// Sınırlı deneme sonunda FAILED kalır; yük temizlenir, sabit hata kodu ve deneme sayısı saklanır.
model NotificationIntent {
  id            String                   @id @default(uuid(7))
  key           String                   @unique
  userId        String
  kind          String
  payload       Json
  status        NotificationIntentStatus @default(PENDING)
  attemptCount  Int                      @default(0)
  nextAttemptAt DateTime?                @default(now())
  failedAt      DateTime?
  failureCode   String?
  createdAt     DateTime                 @default(now())
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt, id])
  @@index([status, nextAttemptAt, id])
}

/// Bildirim türleri; güvenlik bildirimleri daima açıktır.
enum NotificationType {
  ACCOUNT_SECURITY
  GRADUATION_DECISION
  EXPERIENCE_MODERATION
  CONTACT_REQUEST
  CV_INVITATION
  CV_REVIEW
  PROFILE_FRESHNESS
  ALUMNI_STILL_THERE
  STUDENT_EMAIL_MIGRATION
  APPOINTMENT
  FAQ
  JOB_POSTING
  REFERRAL
  JOB_MATCH
  APPLICATION_WINDOW
  MONTHLY_DIGEST
}

enum StillThereChoice {
  YES
  NO
}

/// Tercih yoksa açık kabul edilir; zorunlu güvenlik türü sunucuda kapatılamaz.
model NotificationPreference {
  userId    String
  type      NotificationType
  enabled   Boolean          @default(true)
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
}

/// İmzalı bağlantı sunucuda yeniden üretilebilir; jeton gövdesi saklanmaz.
model NotificationAction {
  id         String            @id @default(uuid(7))
  userId     String
  positionId String
  cycle      String
  expiresAt  DateTime
  usedAt     DateTime?
  choice     StillThereChoice?
  createdAt  DateTime          @default(now())
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  position   Position          @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([userId, positionId, cycle])
  @@index([expiresAt])
}

/// İlk giriş adımı; atlanan ya da tamamlanan adımların kalıcı ilerleme noktası.
enum OnboardingStep {
  MEMBERSHIP
  INTERESTS
  GOALS
  MENTOR_PREFERENCE
  VISIBILITY
  COMPLETE
}

enum TagKind {
  INTEREST
  SKILL
  GOAL
}

/// Kullanıcının kendi profili; kimlik, rol ve yetki kaynağı değildir.
model Profile {
  id                    String           @id @default(uuid(7))
  userId                String           @unique
  headline              String?
  summary               String?
  city                  String?
  goals                 String?
  targetTitleId         String?
  socialLinks           Json?
  linkedinUrl           String?
  completionScore       Int              @default(0)
  cvUpdatedAt           DateTime?
  lastFreshnessPromptAt DateTime?
  lastStillThereCheckAt DateTime?
  onboardingStep        OnboardingStep   @default(MEMBERSHIP)
  mentorInterested      Boolean?
  /// Adım durumu açıkça tutulur: listede yoksa PENDING. İki liste ayrıktır; MEMBERSHIP ve COMPLETE
  /// atlanamaz (ham SQL CHECK). Atlama veriyi silmez (ilgi/hedef/mentor tercihi olduğu gibi kalır).
  /// Kullanıcının kendi düzenlediği temel alanlar (`headline`/`summary`/`city`); yeni CV bunları sessizce ezmez.
  manualFields          String[]         @default([])
  completedSteps        OnboardingStep[] @default([])
  skippedSteps          OnboardingStep[] @default([])
  /// "Staj arıyorum" (P2-06; D20/D28): aday görünürlüğü YALNIZ bu bayrak AÇIK ve `JOB_SEEKER_VISIBILITY` rızası güncel/verilmiş iken vardır
  /// (rıza geri alınınca bayrak ne olursa olsun görünürlük kalkar; sorgu anında son rıza satırına bakar).
  seekingInternship     Boolean          @default(false)
  seekingTermYear       Int?
  seekingTermSeason     TermSeason?
  /// Aday kartının OPAK kimliği (kullanıcı kimliği DEĞİL; rastgele, tahmin edilemez). Görünürlük açılırken üretilir, kapanınca silinir.
  seekerRef             String?          @unique
  /// Kartın mezun aramalarında gösterilme sayısı (kim baktığı tutulmaz).
  seekerViewCount       Int              @default(0)
  /// Mezun: "işe alım yapıyorum" beyanı (D28). Boşsa beyan yok; her an kapatılabilir.
  hiringDeclaredAt      DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetTitle Title?       @relation(fields: [targetTitleId], references: [id], onDelete: SetNull)
  tags        ProfileTag[]
}

/// Sabit sözlük anahtarı; görünen Türkçe karşılık mesaj kataloğundadır.
model Tag {
  id        String   @id @default(uuid(7))
  kind      TagKind
  slug      String
  /// Görünen ad: sabit etiketlerde (ilgi/hedef) boş, metin mesaj kataloğundadır; `SKILL` etiketinde zorunlu
  /// (veritabanı kısıtı). Kullanıcının serbest yazdığı beceri `curated = false` ile açılır ve başkalarına
  /// öneri olarak listelenmez.
  label     String?
  curated   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles    ProfileTag[]
  jobPostings JobPostingTag[]

  @@unique([kind, slug])
}

model ProfileTag {
  profileId String
  tagId     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([profileId, tagId])
  @@index([tagId])
}

/// Üyelik = kullanıcı × bölüm × rol. Rol geçişinde eski satır `endedAt` ile kapanır, yenisi eklenir;
/// geçmiş korunur. İçerik ve puan `userId`'ye bağlanır, üyeliğe değil (bu yüzden geçişten etkilenmez).
model Membership {
  id                 String             @id @default(uuid(7))
  userId             String
  departmentId       String
  role               MembershipRole
  /// Giriş yılı (öğrenci). Sınıf saklanmaz; `rules/classYear` hesaplar.
  entryYear          Int?
  /// Hazırlık/uzatma düzeltmesi (kullanıcı girer): etkin sınıf = hesaplanan + düzeltme.
  classOffset        Int                @default(0)
  graduationYear     Int?
  verificationStatus VerificationStatus @default(PENDING)
  verificationMethod VerificationMethod
  verifiedAt         DateTime?
  verifiedById       String?
  /// Boşsa üyelik etkindir. Aynı kullanıcı+bölüm+rolde en fazla bir etkin satır olabilir.
  endedAt            DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user       User       @relation("MembershipOwner", fields: [userId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  verifiedBy User?      @relation("MembershipVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([departmentId, verificationStatus])
}

/// Kapsamlı yönetici yetkisi. `SYSTEM`: her şey; `FACULTY`: fakülte ve altındaki bölümler;
/// `DEPARTMENT`: yalnız o bölüm. Kaldırılan yetki silinmez, `revokedAt` ile kapanır.
model AdminGrant {
  id           String     @id @default(uuid(7))
  userId       String
  scope        AdminScope
  facultyId    String?
  departmentId String?
  grantedById  String
  revokedAt    DateTime?
  revokedById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user       User        @relation("AdminGrantOwner", fields: [userId], references: [id], onDelete: Restrict)
  faculty    Faculty?    @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  grantedBy  User        @relation("AdminGrantGranter", fields: [grantedById], references: [id], onDelete: Restrict)
  revokedBy  User?       @relation("AdminGrantRevoker", fields: [revokedById], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([facultyId])
  @@index([departmentId])
}

/// Mentorluk = etkin profil. Kapasite ve görüşme süresi mentorun kararıdır; bu yüzden varsayılan yoktur.
model MentorProfile {
  userId               String        @id
  isActive             Boolean       @default(false)
  monthlyCapacity      Int
  /// 15, 20 ya da 30 dakika (veritabanı kısıtı).
  sessionMinutes       Int
  meetingModes         MeetingMode[]
  inPersonNote         String?
  /// “Müsait değilim”: bu tarihe kadar yeni talep alınmaz.
  pausedUntil          DateTime?
  cvReviewEnabled      Boolean       @default(false)
  cvReviewMonthlyLimit Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

/// Yönetici işlem kaydı (D6). YALNIZ EKLENİR: veritabanı tetikleyicisi güncelleme/silme/TRUNCATE'i
/// reddeder. `metadata` ve `reason` kişisel veri içermez (yalnız kimlikler); `recordAdminAction` doğrular.
model AdminAuditLog {
  id         String   @id @default(uuid(7))
  actorId    String
  action     String
  targetType String
  targetId   String
  reason     String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}

// ---------------------------------------------------------------------------------------------
// Kimlik doğrulama (P1-02 sözleşmesi). Better Auth 1.7 Prisma adaptörünün beklediği alanlar
// (`getAuthTables`: user + admin eklentisi, session, account, verification, rateLimit); sözleşme
// docs/data.md. Ham SQL kısıtlar 20261107205405_auth_contract migration'ındadır.
// ---------------------------------------------------------------------------------------------

/// Veritabanı oturumu. Çerez yalnız jetonu taşır (httpOnly, secure, sameSite=lax). Askıya alma ve hesap
/// silmede oturumlar silinir. `impersonatedBy` admin eklentisinin alanıdır; "başka kullanıcı gibi giriş"
/// KAPALIDIR, bu sütun hep boş kalır.
model Session {
  id             String   @id @default(uuid(7))
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  /// Süresi geçmiş oturum temizliği için (indeks migration'da oluşturulur).
  @@index([expiresAt])
}

/// Dış sağlayıcı bağlantısı (LinkedIn). Giriş parolasızdır; `password` Better Auth şemasında bulunur ama
/// KULLANILMAZ. Jetonlar sağlayıcı tarafına aittir; servis adımı onları şifreli saklar (decisions.md).
model Account {
  id                    String    @id @default(uuid(7))
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

/// Süreli, tek kullanımlık doğrulama kayıtları (e-posta bağlantısı, e-posta değiştirme).
model Verification {
  id         String   @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

/// Better Auth hız sınırı deposu (`rateLimit.storage = "database"`): süreçler arasında ve yeniden
/// başlatmada korunur. `lastRequest` milisaniye damgasıdır.
model RateLimit {
  id          String @id @default(uuid(7))
  key         String @unique
  count       Int
  lastRequest BigInt
}

enum GraduationDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Mezun belgesi (e-Devlet barkodlu PDF) doğrulama kuyruğu. Belge dosyası YALNIZ karar verilene kadar
/// durur: karar anında `storageKey` null olur ve dosya silinir (veritabanı kısıtı). Kuyruk bölümün
/// yöneticisine görünür (`departmentId`). Hedef üyelik (kullanıcı + bölüm, `ALUMNI`) `userId` ve
/// `departmentId` ile bulunur; `Membership`'e yabancı anahtar YOKTUR (şema değişmezi).
model GraduationDocument {
  id             String                   @id @default(uuid(7))
  userId         String
  departmentId   String
  /// Kullanıcının beyan ettiği mezuniyet yılı; onayda `ALUMNI` üyeliğine yazılır.
  graduationYear Int
  /// `graduation/<userId>/<uuid>.pdf`; karar verilmiş satırda null.
  storageKey     String?
  status         GraduationDocumentStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  rejectReason   String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  user       User       @relation("GraduationDocumentOwner", fields: [userId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  reviewedBy User?      @relation("GraduationDocumentReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([departmentId, status, createdAt])
  @@index([userId])
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

/// Giden e-posta kaydı (giden kutusu). GÖVDE ve alıcı adresi SAKLANMAZ: yalnız şablon, alıcı kimliği ve
/// durum. `idempotencyKey` aynı e-postanın ikinci kez gönderilmesini engeller. Saklama 6 ay (docs/data.md).
model EmailLog {
  id              String      @id @default(uuid(7))
  idempotencyKey  String      @unique
  template        String
  /// Kayıtsız adrese giden giriş bağlantısında boştur (kayıtlı olup olmadığı sızmasın diye ayrım yok).
  recipientUserId String?
  status          EmailStatus @default(QUEUED)
  attempts        Int         @default(0)
  errorCode       String?
  sentAt          DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  recipientUser User? @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([recipientUserId])
}

// ---------------------------------------------------------------------------------------------
// KVKK ve kontrollü iletişim (P1-03 sözleşmesi). Kurallar: docs/security.md “KVKK”; görünürlük kararı
// yalnız `src/server/rules/visibility.ts`. Ham SQL kısıtlar 20261108000000_privacy_contract migration'ındadır.
// ---------------------------------------------------------------------------------------------

/// Onaylanan hukuki metin (docs/legal-drafts.md §1–§3).
enum ConsentDocument {
  PRIVACY_NOTICE
  TERMS_OF_USE
  CROSS_BORDER_TRANSFER
  /// P2-06: "staj arıyorum" görünürlüğü (isteğe bağlı rıza; geri alınınca görünürlük hemen kalkar).
  JOB_SEEKER_VISIBILITY
}

/// Rıza kaydı: YALNIZ EKLENİR (güncellenmez, silinmez — tetikleyici). Geri çekme yeni satırdır
/// (`granted = false`). Bir belgenin geçerli durumu, o belge için en son satırdır. Hesap silmede kalır
/// (kişisel alan taşımaz; hukuki kanıttır).
model Consent {
  id           String          @id @default(uuid(7))
  userId       String
  documentType ConsentDocument
  /// Metin sürümü (örn. `taslak-1`); güncel sürümle aynı değilse kullanıcı yeniden onaya yönlenir.
  version      String
  granted      Boolean
  createdAt    DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, documentType, createdAt])
}

/// İletişim/kişisel alan (görünürlüğü kullanıcı seçer).
enum ContactField {
  EMAIL
  PHONE
  SOCIAL_LINKS
  LINKEDIN
}

/// `PRIVATE`: yalnız sahibi (yönetici yalnız görev ekranında, maskeli) · `ON_APPROVED_REQUEST`: onaylı
/// iletişim talebi sahibine · `MEMBERS`: doğrulanmış üyelere.
enum VisibilityLevel {
  PRIVATE
  ON_APPROVED_REQUEST
  MEMBERS
}

/// Alan başına görünürlük. Satır yoksa varsayılan geçerlidir (e-posta/telefon `ON_APPROVED_REQUEST`,
/// sosyal/LinkedIn `MEMBERS` — `src/contracts/privacy.ts` `DEFAULT_FIELD_VISIBILITY`).
model FieldVisibility {
  id        String          @id @default(uuid(7))
  userId    String
  field     ContactField
  level     VisibilityLevel
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, field])
}

/// `PENDING` → `APPROVED` | `REJECTED` (hedef karar verir) · `PENDING` → `WITHDRAWN` (talep eden geri çeker)
/// · `APPROVED` → `REVOKED` (hedef istediği an geri alır; alanlar yeniden kapanır).
enum ContactRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  REVOKED
}

/// İletişim talebi: onaylanınca istenen alanlar YALNIZ talep edene açılır (görünürlük kuralı bunu okur).
/// Aynı ikili için aynı anda en fazla bir açık (bekleyen ya da onaylı) talep olur.
enum ContactRequestSource {
  PROFILE
  JOB_POSTING
  /// P2-06: mezun, "staj arıyorum" aday kartı üzerinden talep gönderdi (hedef öğrenci onaydan önce açılmaz).
  SEEKER_PROFILE
}

model ContactRequest {
  id                 String               @id @default(uuid(7))
  requesterId        String
  targetId           String
  fields             ContactField[]
  /// İsteğe bağlı kısa not (≤ 500 karakter); hedefe görünür.
  message            String?
  status             ContactRequestStatus @default(PENDING)
  /// Onay ya da ret anı.
  decidedAt          DateTime?
  /// Geri çekme (`WITHDRAWN`) ya da geri alma (`REVOKED`) anı.
  closedAt           DateTime?
  /// Talebin KAYNAĞI (P2-04, D7): `JOB_POSTING` ise talep ilan üzerinden gönderilmiştir; sunucu yazar ve doldurur (istemciden alınmaz).
  /// İlan kaynaklı talepte hedefin kimliği/adı talep edene YALNIZ `APPROVED`'da açılır; o zamana dek ilan başlığı ve kurum
  /// (`sourceTitle`/`sourceOrganization`, talep anındaki özet: ilan silinse/kapansa da kalır) gösterilir. `jobPostingId` yalnız bağlantıdır
  /// (ilan silinirse `SET NULL`; kaynak işareti `source` ve özet kalır).
  source             ContactRequestSource @default(PROFILE)
  jobPostingId       String?
  sourceTitle        String?
  sourceOrganization String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  requester  User        @relation("ContactRequestRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  target     User        @relation("ContactRequestTarget", fields: [targetId], references: [id], onDelete: Restrict)
  jobPosting JobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)

  @@index([targetId, status, createdAt])
  @@index([requesterId, status, createdAt])
  @@index([jobPostingId])
}

// ---------------------------------------------------------------------------------------------
// CV ayrıştırma hattı (P1-05) — docs/architecture.md "CV ayrıştırma hattı"
// ---------------------------------------------------------------------------------------------

/// `QUEUED` → `PARSING` → `PARSED` (kullanıcı onayını bekler) | `FAILED`; `PARSED` → `APPLIED` | `DISCARDED`.
/// Veritabanı kısıtları: ayrıştırma çıktısı (`parsedJson`) yalnız `PARSED`'dadır; `FAILED` bir `errorCode`
/// taşır; bir kullanıcının en fazla bir işlenen (`QUEUED`/`PARSING`) ve bir onay bekleyen (`PARSED`) CV'si vardır.
enum CvUploadSource {
  CV
  LINKEDIN_PDF
}

enum CvStatus {
  QUEUED
  PARSING
  PARSED
  FAILED
  APPLIED
  DISCARDED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
  FREELANCE
  VOLUNTEER
  OTHER
}

enum EducationLevel {
  HIGH_SCHOOL
  ASSOCIATE
  BACHELOR
  MASTER
  DOCTORATE
  OTHER
}

enum LanguageLevel {
  A1
  A2
  B1
  B2
  C1
  C2
  NATIVE
}

/// Profil kaleminin kaynağı: `CV` (ayrıştırma önerisi kullanıcı onayıyla yazıldı) ya da `MANUAL` (elle).
enum ProfileEntrySource {
  CV
  MANUAL
}

enum DictionaryKind {
  COMPANY
  TITLE
  SKILL
  SECTOR
}

enum ExperienceInvitationStatus {
  OPEN
  DISMISSED
}

/// Yüklenen CV (PDF) ve ayrıştırma durumu. `storageKey`: `cv/<userId>/<uuid>.pdf`; son uygulanan CV'nin dosyası
/// kalır, eski dosyalar uygulama/atma anında silinir (açık incelemeye bağlı dosya hariç), hatada anında silinir.
/// `parsedJson`: doğrulanmış `ParsedCv`, uygulama/atma anında temizlenir; LLM çıktısı yetki belirlemez.
model CvUpload {
  id         String         @id @default(uuid(7))
  userId     String
  storageKey String?
  byteSize   Int
  pageCount  Int
  source     CvUploadSource @default(CV)
  status     CvStatus       @default(QUEUED)
  parsedJson Json?
  /// `FAILED` için kararlı hata kodu (`ERROR_CODES`).
  errorCode  String?
  /// LLM çağrı denemeleri (iş yeniden denemeleri dahil); yalnız sayaç.
  attempts   Int            @default(0)
  appliedAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  reviewRequests CvReviewRequest[]

  @@index([userId, createdAt])
}

enum CvReviewRequestStatus {
  OPEN
  COMPLETED
  EXPIRED
}

/// İnceleme kapandığında mentor dosya yetkisi biter; kullanıcı silinince kişisel metin temizlenir.
model CvReviewRequest {
  id         String                @id @default(uuid(7))
  studentId  String
  mentorId   String
  cvUploadId String
  status     CvReviewRequestStatus @default(OPEN)
  note       String
  comment    String?
  createdAt  DateTime              @default(now())
  expiresAt  DateTime
  answeredAt DateTime?
  helpfulAt  DateTime?
  student    User                  @relation("CvReviewStudent", fields: [studentId], references: [id], onDelete: Restrict)
  mentor     User                  @relation("CvReviewMentor", fields: [mentorId], references: [id], onDelete: Restrict)
  cvUpload   CvUpload              @relation(fields: [cvUploadId], references: [id], onDelete: Restrict)

  @@index([mentorId, createdAt])
  @@index([studentId, createdAt])
  @@index([status, expiresAt])
  @@index([cvUploadId, status])
}

/// Sözlükler (sistem yöneticisinin): `normalizedName` benzersiz, `aliases` normalleştirilmiş takma adlar.
/// Eşleme `pg_trgm` benzerliğiyle (eşik `src/server/rules/dictionary.ts`); eşik altı değer `UnmatchedValue`'ya düşer.
model Sector {
  id             String          @id @default(uuid(7))
  name           String
  normalizedName String          @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  companies      Company[]
  positions      Position[]
  followers      CompanyFollow[]

  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Sector_normalizedName_trgm")
}

model Company {
  id             String          @id @default(uuid(7))
  name           String
  normalizedName String          @unique
  aliases        String[]
  searchKeys     String?         @default(dbgenerated())
  sectorId       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sector         Sector?         @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  positions      Position[]
  followers      CompanyFollow[]
  jobPostings    JobPosting[]

  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Company_normalizedName_trgm")
  @@index([searchKeys(ops: raw("gin_trgm_ops"))], type: Gin, map: "Company_searchKeys_trgm")
}

/// Birleştirilen eski kimlik, hedefe yönlendirme ve idempotent tekrar için korunur.
model CompanyMerge {
  sourceId  String   @id
  targetId  String
  createdAt DateTime @default(now())

  @@index([targetId])
}

/// Exactly one of companyId and sectorId is set; the database enforces this invariant.
model CompanyFollow {
  id        String   @id @default(uuid(7))
  userId    String
  companyId String?
  sectorId  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sector    Sector?  @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@unique([userId, sectorId])
  @@index([companyId])
  @@index([sectorId])
}

model Title {
  id             String     @id @default(uuid(7))
  name           String
  normalizedName String     @unique
  aliases        String[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  positions      Position[]
  targetProfiles Profile[]

  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Title_normalizedName_trgm")
}

model Skill {
  id             String      @id @default(uuid(7))
  name           String
  normalizedName String      @unique
  aliases        String[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  userSkills     UserSkill[]

  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Skill_normalizedName_trgm")
}

/// Sözlükte eşleşmeyen, kullanıcının ONAYLADIĞI değerler (yönetici kuyruğu). Kişi bilgisi tutmaz: yalnız değer,
/// normalleştirilmiş hali ve kaç kez görüldüğü. `resolvedToId`: yönetici sözlük kaydına bağladıysa onun kimliği.
model UnmatchedValue {
  id              String         @id @default(uuid(7))
  kind            DictionaryKind
  rawValue        String
  normalizedValue String
  count           Int            @default(1)
  resolvedToId    String?
  /// Yönetici değeri anlamsız bulup kuyruktan düşürdü (P1-11). Aynı değer yeniden gelirse sayaç artar, kuyruk
  /// yeniden AÇILMAZ. Durum: açık = ikisi de boş; çözüldü = `resolvedToId`; atıldı = `dismissedAt`.
  dismissedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([kind, normalizedValue])
  @@index([kind, count])
}

/// Profil kalemleri (P1-06 ekranı gösterir/düzenler). Kullanıcıya bağlıdır (üyeliğe değil). `manuallyEdited`
/// (ya da `source = MANUAL`) kalem yeni CV ile SESSİZCE ezilmez: çakışma olarak ayrı gösterilir.
model Education {
  id             String             @id @default(uuid(7))
  userId         String
  institution    String
  level          EducationLevel?
  fieldOfStudy   String?
  startYear      Int?
  startMonth     Int?
  endYear        Int?
  endMonth       Int?
  isCurrent      Boolean            @default(false)
  source         ProfileEntrySource
  manuallyEdited Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Position {
  id             String             @id @default(uuid(7))
  userId         String
  companyId      String?
  companyRaw     String
  titleId        String?
  titleRaw       String
  sectorId       String?
  employmentType EmploymentType?
  startYear      Int?
  startMonth     Int?
  endYear        Int?
  endMonth       Int?
  isCurrent      Boolean            @default(false)
  description    String?
  source         ProfileEntrySource
  manuallyEdited Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  company             Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  title               Title?                @relation(fields: [titleId], references: [id], onDelete: SetNull)
  sector              Sector?               @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  invitation          ExperienceInvitation?
  notificationActions NotificationAction[]

  @@index([userId])
}

model Language {
  id             String             @id @default(uuid(7))
  userId         String
  name           String
  normalizedName String
  level          LanguageLevel?
  source         ProfileEntrySource
  manuallyEdited Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedName])
}

model Certification {
  id             String             @id @default(uuid(7))
  userId         String
  name           String
  issuer         String?
  issuedYear     Int?
  issuedMonth    Int?
  source         ProfileEntrySource
  manuallyEdited Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// ESKİ (P1-06 ile bırakıldı): beceriler artık `Tag(SKILL)` + `ProfileTag`'tir. Veri taşındı; tablo ekleyici
/// politikası gereği bir sonraki daraltma migration'ında kaldırılır (BACKLOG TD-013).
model UserSkill {
  id             String             @id @default(uuid(7))
  userId         String
  skillId        String?
  name           String
  normalizedName String
  source         ProfileEntrySource
  manuallyEdited Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill? @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@unique([userId, normalizedName])
}

/// CV'den gelen her staj pozisyonu için "bu stajı yazmak ister misin?" daveti (P1-07 deneyimi bağlar).
/// Pozisyon başına en fazla bir davet; deneyim tablosu gelene kadar yazılmış deneyim yoktur.
model ExperienceInvitation {
  id         String                     @id @default(uuid(7))
  userId     String
  positionId String                     @unique
  status     ExperienceInvitationStatus @default(OPEN)
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// P1-07: tür bazlı deneyim ve şikâyet sözleşmesi. Yayın/erişim iş mantığı servis kartındadır.
enum ExperienceType {
  INTERNSHIP
  ERASMUS
  COMPETITION
  HACKATHON
  CLUB
  CERTIFICATE
  GRADUATE_STUDY
  STUDY_ABROAD
}

enum ExperienceStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
}

enum TermSeason {
  SPRING
  SUMMER
  AUTUMN
  WINTER
}

enum ExperiencePay {
  PAID
  UNPAID
  NOT_DISCLOSED
}

enum ApplicationChannel {
  LINKEDIN_POST
  CAREER_PLATFORM
  COMPANY_SITE
  REFERRAL
  CAREER_FAIR
  COLD_EMAIL
  UNIVERSITY_ANNOUNCEMENT
  OTHER
}

enum ReportTargetType {
  EXPERIENCE
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// Taslak eksik olabilir; PENDING/PUBLISHED/REJECTED içerik tür şablonunu tamamlamış olmalıdır.
/// Anonimlik çıktı sınırıdır: authorId sahiplik/hesap silme için depoda kalır, hiçbir anonim çıktıya girmez.
model Experience {
  id                  String                   @id @default(uuid(7))
  authorId            String?
  /// Yazım anındaki doğrulanmış üyelikten; sonradan rol/bölüm değişimi moderasyon kapsamını değiştirmez.
  departmentIdAtWrite String
  type                ExperienceType
  /// Company sözlüğü P1-05'te vardır; deneyim FK bağlantısı P1-08'de eklenir.
  companyId           String?
  organizationName    String?
  country             String?
  city                String?
  termYear            Int?
  termSeason          TermSeason?
  appliedMonth        Int?
  durationWeeks       Int?
  pay                 ExperiencePay?
  applicationChannel  ApplicationChannel?
  processSteps        Json                     @default("[]")
  interviewQuestions  String[]                 @default([])
  whatLearned         String                   @default("")
  advice              String                   @default("")
  isAnonymous         Boolean                  @default(false)
  status              ExperienceStatus         @default(DRAFT)
  moderationNote      String?
  moderatedById       String?
  moderatedAt         DateTime?
  publishedAt         DateTime?
  /// Üretilmiş arama sütunları (GENERATED ALWAYS; P1-08 ham SQL migration'ı). Prisma yazamaz; istemcide global `omit`
  /// ile hiçbir sorguda varsayılan dönmez (`src/server/db.ts`). Yalnız `repositories/search.ts` ham SQL ile okur.
  /// `dbgenerated()` ve aşağıdaki GIN indeksleri `migrate dev`'in yanlış ALTER/DROP üretmesini önler (docs/decisions.md).
  searchVector        Unsupported("tsvector")? @default(dbgenerated())
  searchKeys          String?                  @default(dbgenerated())
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  author      User?      @relation("ExperienceAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  department  Department @relation(fields: [departmentIdAtWrite], references: [id], onDelete: Restrict)
  moderatedBy User?      @relation("ExperienceModerator", fields: [moderatedById], references: [id], onDelete: Restrict)
  reports     Report[]

  @@index([authorId, updatedAt])
  @@index([departmentIdAtWrite, status, createdAt])
  @@index([status, publishedAt])
  @@index([type, termYear])
  @@index([searchVector], type: Gin, map: "Experience_searchVector_idx")
  @@index([searchKeys(ops: raw("gin_trgm_ops"))], type: Gin, map: "Experience_searchKeys_trgm")
}

/// Şimdilik tek hedef türü deneyimdir; hedef FK ile korunur. SSS kendi sözleşmesinde eklenir.
/// Raportör kimliği hiçbir çıktı şemasında yoktur; hesap silmede koparılabilir.
model Report {
  id             String           @id @default(uuid(7))
  targetType     ReportTargetType @default(EXPERIENCE)
  targetId       String
  reporterId     String?
  reason         String
  status         ReportStatus     @default(OPEN)
  reviewedById   String?
  reviewedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  target     Experience @relation(fields: [targetId], references: [id], onDelete: Cascade)
  reporter   User?      @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reviewedBy User?      @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([targetId, status])
  @@index([status, createdAt])
  @@index([reporterId])
}

enum EventType {
  LOGIN
  PROFILE_THRESHOLD
  CV_UPLOADED
  CV_APPLIED
  EXPERIENCE_PUBLISHED
  SEARCH
  MENTOR_SEARCH
  MENTOR_VIEWED
  APPOINTMENT_REQUESTED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_COMPLETED
  FAQ_REQUESTED
  FAQ_PUBLISHED
  CV_REVIEW_REQUESTED
  CONTACT_REQUESTED
  JOB_POSTING_PUBLISHED
  JOB_POSTING_VIEWED
  JOB_POSTING_SEARCH
  JOB_SEEKER_SEARCH
}

/// Kullanım metrikleri (P1-13). `props` KİŞİSEL VERİ taşımaz (Zod strict + veritabanı CHECK). `role` ve `departmentId`
/// olay anındaki üyelik anlık görüntüsüdür. `userId` 24 ay sonra ve hesap silmede `null` yapılır; sayılar kalır.
model Event {
  id           String          @id @default(uuid(7))
  type         EventType
  userId       String?
  role         MembershipRole?
  departmentId String?
  props        Json            @default("{}")
  createdAt    DateTime        @default(now())

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@index([type, createdAt])
  @@index([departmentId, createdAt])
  @@index([userId, createdAt])
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  CANCELLED
  EXPIRED
  COMPLETED
  NO_SHOW
}

/// Mentorun haftalık müsaitliği (P1-10). `weekday` 1 = pazartesi … 7 = pazar; dakikalar `Europe/Istanbul` yerel günüdür.
/// `mode` boşsa iki biçim de. Aynı mentor+gün aralıkları çakışamaz (exclusion, ham SQL migration).
model AvailabilityRule {
  id          String       @id @default(uuid(7))
  mentorId    String
  weekday     Int
  startMinute Int
  endMinute   Int
  mode        MeetingMode?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  mentor User @relation(fields: [mentorId], references: [id], onDelete: Restrict)

  @@index([mentorId, weekday])
}

/// Randevu (P1-10). Aynı mentorun REQUESTED/CONFIRMED aralıkları ve aynı öğrencinin REQUESTED/CONFIRMED aralıkları
/// çakışamaz (exclusion constraint, ham SQL migration): çakışmanın son sözü veritabanıdır. `expiresAt` yalnız REQUESTED
/// için anlamlıdır (D11). Hesap silmede açık randevular iptal edilir ve notlar temizlenir (satır kalır).
model Appointment {
  id                String            @id @default(uuid(7))
  mentorId          String
  menteeId          String
  startsAt          DateTime
  endsAt            DateTime
  mode              MeetingMode
  menteeNote        String?
  /// Yüz yüze: onayda mentorun yer notundan kopyalanır (sonradan değişen ayar randevuyu değiştirmez).
  location          String?
  status            AppointmentStatus @default(REQUESTED)
  expiresAt         DateTime
  decidedAt         DateTime?
  decisionNote      String?
  meetUrl           String?
  calendarEventId   String?
  /// Takvim etkinliği oluşturma kesin başarısız oldu (ya da adaptör kapalı): mentor elle link ekler.
  calendarFailedAt  DateTime?
  /// Takvim etkinliği oluşturma deneme sayısı (en çok 3; sonra mentor elle link ekler).
  calendarAttempts  Int               @default(0)
  reminderSentAt    DateTime?
  cancelledById     String?
  cancelledBySystem Boolean           @default(false)
  cancelReason      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  mentor      User              @relation("AppointmentMentor", fields: [mentorId], references: [id], onDelete: Restrict)
  mentee      User              @relation("AppointmentMentee", fields: [menteeId], references: [id], onDelete: Restrict)
  cancelledBy User?             @relation("AppointmentCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  feedbacks   SessionFeedback[]

  @@index([mentorId, status, startsAt])
  @@index([menteeId, status, startsAt])
  @@index([status, expiresAt])
}

/// Görüşme sonu yanıtı: her katılımcı aynı randevu için yalnız bir kez yanıtlar.
model SessionFeedback {
  id            String      @id @default(uuid(7))
  appointmentId String
  authorId      String
  happened      Boolean
  helpful       Boolean?
  note          String?
  createdAt     DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  author        User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, authorId])
  @@index([authorId, createdAt])
}

// ---------------------------------------------------------------------------------------------
// Puan motoru (P1-16; docs/architecture.md "Puan motoru ve hile önleme")
// ---------------------------------------------------------------------------------------------

enum PointAction {
  EXPERIENCE_PUBLISHED
  FAQ_QUESTION_PUBLISHED
  FAQ_ANSWER_SELECTED
  FAQ_ANSWER_PARTICIPATION
  CV_REVIEW_HELPFUL
  SESSION_ONLINE
  SESSION_IN_PERSON
  /// P2-04: veritabanı enum sırası ekleme sırasıdır (sona eklenir); `POINT_ACTIONS` sırası aynıdır.
  JOB_POSTING_PUBLISHED
  REFERRAL_GIVEN
  REFERRAL_ACCEPTED
  EVENT_ATTENDED
}

enum PointSourceType {
  EXPERIENCE
  APPOINTMENT
  CV_REVIEW
  FAQ_REQUEST
  FAQ_ANSWER
  JOB_POSTING
  REFERRAL
  CAMPUS_EVENT
}

enum PointStatus {
  PENDING
  FINAL
  REVOKED
}

enum PointRevokeReason {
  ADMIN_CANCEL
  FRAUD_CONFIRMED
  /// Puanı doğuran ilan kesinleşmeden geri çekildi/kaldırıldı (P2-04).
  POSTING_WITHDRAWN
  REFERRAL_CANCELLED
  EVENT_CANCELLED
}

enum SuspicionRule {
  BURST
  SINGLE_COUNTERPART
  SYNC_FEEDBACK
  REFERRAL_REPEAT
  REFERRAL_BURST
  EVENT_BURST
  EVENT_NETWORK
}

enum SuspicionStatus {
  OPEN
  CONFIRMED
  DISMISSED
}

enum BadgeKind {
  FOUNDING_MEMBER
}

/// Puan kuralı (K-11; sistem yöneticisi değiştirir). Değişiklik yalnız GELECEKTEKİ kayıtları etkiler:
/// `PointEntry.basePoints` kayıt anındaki değeri saklar. `updatedById` işlem kaydının (AdminAuditLog) aktörüyle aynıdır.
model PointRule {
  action      PointAction @id
  points      Int
  delayDays   Int         @default(0)
  isActive    Boolean     @default(true)
  updatedAt   DateTime    @updatedAt
  updatedById String?
}

/// Puan kaydı. `(userId, action, sourceType, sourceId)` benzersizdir: aynı olay iki kez puan üretemez. `sourceId`
/// YALNIZ sunucuda kalır (anonim deneyimin yazar bağını çıktıya taşımamak için). `points = basePoints * multiplierPercent / 100`
/// (tam sayı, aşağı yuvarlanır; CHECK). `eventAt` olayın gerçekleştiği an (ikili tavanı ve azalan çarpan bunun takvimine bakar).
/// Durum tutarlılığı CHECK'lerle zorlanır (ham SQL migration).
model PointEntry {
  id                String             @id @default(uuid(7))
  userId            String
  action            PointAction
  sourceType        PointSourceType
  sourceId          String
  counterpartId     String?
  basePoints        Int
  multiplierPercent Int                @default(100)
  points            Int
  status            PointStatus        @default(FINAL)
  eventAt           DateTime
  createdAt         DateTime           @default(now())
  finalizesAt       DateTime?
  finalizedAt       DateTime?
  revokedAt         DateTime?
  revokedById       String?
  revokedReason     PointRevokeReason?

  user        User        @relation("PointOwner", fields: [userId], references: [id], onDelete: Restrict)
  counterpart User?       @relation("PointCounterpart", fields: [counterpartId], references: [id], onDelete: SetNull)
  badges      UserBadge[]

  @@unique([userId, action, sourceType, sourceId])
  @@index([userId, status, createdAt])
  @@index([status, finalizesAt])
  @@index([userId, counterpartId, eventAt])
}

/// Şüphe işareti (ceza değildir; sistem yöneticisi karar verir). `evidenceKey` işaretin dayandığı kayıtların özetidir:
/// aynı kanıt iki kez işaretlenmez. Aynı (kullanıcı, kural) için en çok bir `OPEN` işaret vardır (kısmi benzersiz indeks,
/// ham SQL migration). Yalnız sayılar ve kayıt kimlikleri saklanır; kişisel veri yok.
model SuspicionFlag {
  id               String          @id @default(uuid(7))
  userId           String
  rule             SuspicionRule
  status           SuspicionStatus @default(OPEN)
  evidenceKey      String
  entryIds         String[]
  windowStart      DateTime
  windowEnd        DateTime
  entryCount       Int
  points           Int
  sharePercent     Int?
  syncedCount      Int?
  createdAt        DateTime        @default(now())
  decidedAt        DateTime?
  decidedById      String?
  /// Açıkken aynı kural için GÖRÜLEN YENİ kanıt sayısı (karar bekleyen işarete eklenir; yeni işaret açılmaz) ve son görülme.
  /// `seenEvidenceKeys` tekrarı önler (aynı tarama iki kez sayacı bir kez artırır; en çok 20). `recentEvidence`: en çok 5
  /// kanıt özeti `{at, entryCount, points}` (yalnız sayılar).
  recurrenceCount  Int             @default(0)
  lastSeenAt       DateTime?
  seenEvidenceKeys String[]        @default([])
  recentEvidence   Json            @default("[]")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, rule, evidenceKey])
  @@index([status, createdAt])
}

/// Platform içi etiket (K-10: pilot süresince ilk deneyimi yayınlanan). Kullanıcı başına tür başına bir satır;
/// geri alınırsa (`revokedAt`) otomatik yeniden verilmez. `sourceEntryId`: etiketi doğuran puan kaydı (o geri alınınca etiket de).
model UserBadge {
  id            String    @id @default(uuid(7))
  userId        String
  kind          BadgeKind
  sourceEntryId String?
  awardedAt     DateTime  @default(now())
  revokedAt     DateTime?

  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  sourceEntry PointEntry? @relation(fields: [sourceEntryId], references: [id], onDelete: SetNull)

  @@unique([userId, kind])
}

// ---------------------------------------------------------------------------------------------
// SSS akışı (P1-17; docs/architecture.md "SSS akışı")
// ---------------------------------------------------------------------------------------------

enum FaqStatus {
  OPEN
  PUBLISHED
  REJECTED
  REDIRECTED
}

/// Öğrencinin SSS talebi. `askerId` yalnız sahiplik/hesap silme içindir ve HİÇBİR çıktıya (mentor, moderatör, yayın) girmez;
/// hesap silmede yayınlanmamış talepler silinir, yayınlanmışta bağ koparılır. `departmentIdAtWrite` moderasyon kapsamını
/// ve yayının görünürlüğünü (K-07) belirler. Karar alanları CHECK ile tutarlıdır (ham SQL migration).
model FaqRequest {
  id                  String    @id @default(uuid(7))
  askerId             String?
  departmentIdAtWrite String
  question            String
  status              FaqStatus @default(OPEN)
  /// REJECTED: ret gerekçesi; REDIRECTED: yönlendirme notu (soran öğrenciye gösterilir).
  decisionNote        String?
  decidedById         String?
  decidedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  asker      User?       @relation("FaqAsker", fields: [askerId], references: [id], onDelete: Restrict)
  department Department  @relation(fields: [departmentIdAtWrite], references: [id], onDelete: Restrict)
  answers    FaqAnswer[]
  item       FaqItem?

  @@index([status, departmentIdAtWrite, createdAt])
  @@index([askerId, createdAt])
}

/// Mentor cevabı: talep başına mentor başına bir cevap. Yayında en çok bir cevap `isSelected` olur (kısmi benzersiz indeks).
/// `mentorId` yalnız sahiplik içindir (hesap silmede yayınlanmışta koparılır) ve hiçbir çıktıya girmez.
model FaqAnswer {
  id         String   @id @default(uuid(7))
  requestId  String
  mentorId   String?
  body       String
  isSelected Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  request FaqRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  mentor  User?      @relation(fields: [mentorId], references: [id], onDelete: Restrict)

  @@unique([requestId, mentorId])
  @@index([mentorId, createdAt])
}

/// Yayınlanan SSS: moderatörün düzenlediği metin; hiçbir kimlik taşımaz. `publishedById` yalnız iç kayıttır.
/// Arama sütunları üretilmiştir (GENERATED ALWAYS; ham SQL migration) ve Experience ile aynı kuralla modellenir.
model FaqItem {
  id                  String                   @id @default(uuid(7))
  sourceRequestId     String                   @unique
  departmentIdAtWrite String
  question            String
  answer              String
  publishedById       String?
  publishedAt         DateTime                 @default(now())
  searchVector        Unsupported("tsvector")? @default(dbgenerated())
  searchKeys          String?                  @default(dbgenerated())

  request    FaqRequest @relation(fields: [sourceRequestId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentIdAtWrite], references: [id], onDelete: Restrict)

  @@index([publishedAt(sort: Desc), id])
  @@index([searchVector], type: Gin, map: "FaqItem_searchVector_idx")
  @@index([searchKeys(ops: raw("gin_trgm_ops"))], type: Gin, map: "FaqItem_searchKeys_trgm")
}

// ---------------------------------------------------------------------------------------------
// P2-04 · Mezun staj/iş ilanları (docs/faz2-plan.md, D19)
// ---------------------------------------------------------------------------------------------

enum JobPostingStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  EXPIRED
  CLOSED
}

enum JobPostingKind {
  INTERNSHIP
  JOB
}

/// Başvuru yolu platform dışındadır (D19): `https` bağlantısı ya da yazara iletişim talebi (D7).
enum JobApplyMethod {
  URL
  CONTACT_REQUEST
}

/// İlan. Taslak eksik olabilir; DRAFT dışındaki her durum içeriği tamamlamış olmalıdır (CHECK). `departmentIdAtWrite`
/// MODERASYON KAPSAMIDIR (yazarın yazım anındaki doğrulanmış üyeliği); hedef bölümler `JobPostingDepartment`'tadır.
/// Yazar kimliği okuyucuya çıkmaz (yalnız moderatöre ad; iletişim yolu `CONTACT_REQUEST` ise yazar kimliği bağlantı için döner).
/// `deadlineOn` takvim günüdür (İstanbul): o günün sonuna kadar açıktır; yayından en çok 60 gün sonrası olabilir (CHECK).
/// Arama sütunları üretilmiştir (GENERATED ALWAYS; ham SQL migration) ve Experience ile aynı kuralla modellenir.
model JobPosting {
  id                  String                   @id @default(uuid(7))
  authorId            String
  departmentIdAtWrite String
  kind                JobPostingKind           @default(INTERNSHIP)
  title               String?
  companyId           String?
  organizationName    String?
  location            String?
  isRemote            Boolean                  @default(false)
  description         String?
  applyMethod         JobApplyMethod?
  applyUrl            String?
  deadlineOn          DateTime?                @db.Date
  targetGrades        Int[]                    @default([])
  status              JobPostingStatus         @default(DRAFT)
  submittedAt         DateTime?
  moderationNote      String?
  moderatedById       String?
  moderatedAt         DateTime?
  publishedAt         DateTime?
  /// `EXPIRED` (süre doldu) ya da `CLOSED` (yazar çekti / moderatör kaldırdı) anı. `endedById`: yalnız moderatör kaldırmasında.
  endedAt             DateTime?
  endedById           String?
  searchVector        Unsupported("tsvector")? @default(dbgenerated())
  searchKeys          String?                  @default(dbgenerated())
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  author          User                   @relation("JobPostingAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  department      Department             @relation(fields: [departmentIdAtWrite], references: [id], onDelete: Restrict)
  company         Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  moderatedBy     User?                  @relation("JobPostingModerator", fields: [moderatedById], references: [id], onDelete: Restrict)
  endedBy         User?                  @relation("JobPostingEnder", fields: [endedById], references: [id], onDelete: Restrict)
  targets         JobPostingDepartment[]
  tags            JobPostingTag[]
  matches         JobMatch[]
  reports         JobPostingReport[]
  contactRequests ContactRequest[]
  referrals       ReferralClaim[]

  @@index([authorId, updatedAt])
  @@index([departmentIdAtWrite, status, createdAt])
  @@index([status, publishedAt(sort: Desc), id])
  @@index([status, deadlineOn])
  @@index([searchVector], type: Gin, map: "JobPosting_searchVector_idx")
  @@index([searchKeys(ops: raw("gin_trgm_ops"))], type: Gin, map: "JobPosting_searchKeys_trgm")
}

/// İlanın hedef bölümleri (süzgeç ve eşleştirme için; görünürlük K-07 üniversite düzeyindedir). Hepsi yazarın üniversitesindendir.
model JobPostingDepartment {
  postingId    String
  departmentId String

  posting    JobPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([postingId, departmentId])
  @@index([departmentId])
}

/// İlanın açıkça seçilen sözlük etiketleri; metinden etiket türetilmez.
model JobPostingTag {
  postingId String
  tagId     String

  posting JobPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  tag     Tag        @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([postingId, tagId])
  @@index([tagId])
}

/// Öğrencinin yayın sırasında eşleşen ilanları; yalnız kendi panosunda kullanılır.
model JobMatch {
  postingId String
  userId    String
  createdAt DateTime   @default(now())
  posting   JobPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postingId, userId])
  @@index([userId, createdAt])
}

/// Günlük özet hakkı: eşzamanlı işçiler için benzersiz İstanbul günü.
model JobMatchDigest {
  userId    String
  day       String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([userId, createdAt])
}

/// İlan şikâyeti (deneyim `Report`'u hedefe FK ile bağlıdır; çok biçimli hedef yerine ayrı tablo). Raportör kimliği hiçbir çıktıda yoktur.
model JobPostingReport {
  id             String       @id @default(uuid(7))
  postingId      String
  reporterId     String?
  reason         String
  status         ReportStatus @default(OPEN)
  reviewedById   String?
  reviewedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  posting    JobPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  reporter   User?      @relation("JobPostingReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reviewedBy User?      @relation("JobPostingReportReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([postingId, status])
  @@index([status, createdAt])
  @@index([reporterId])
}

/// Referans kanıt zinciri: kimlikli belge yüklenmez, iki aşamanın kararları ayrı tutulur.
enum ReferralStatus {
  PROPOSED
  STUDENT_CONFIRMED
  APPROVED
  REJECTED
  CANCELLED
  ACCEPTED_PROPOSED
  ACCEPTED_ALUMNI_CONFIRMED
  ACCEPTED_APPROVED
  ACCEPTED_REJECTED
}

model ReferralClaim {
  id                     String         @id @default(uuid(7))
  alumnusId              String
  studentId              String
  departmentIdAtWrite    String
  jobPostingId           String?
  organizationName       String?
  note                   String?
  status                 ReferralStatus @default(PROPOSED)
  studentConfirmedAt     DateTime?
  reviewedById           String?
  reviewedAt             DateTime?
  decisionReason         String?
  approvedAt             DateTime?
  cancelledAt            DateTime?
  acceptanceNote         String?
  acceptanceProposedAt   DateTime?
  alumniConfirmedAt      DateTime?
  acceptanceReviewedById String?
  acceptanceReviewedAt   DateTime?
  acceptanceReason       String?
  acceptanceApprovedAt   DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  alumnus            User        @relation("ReferralAlumnus", fields: [alumnusId], references: [id], onDelete: Restrict)
  student            User        @relation("ReferralStudent", fields: [studentId], references: [id], onDelete: Restrict)
  department         Department  @relation(fields: [departmentIdAtWrite], references: [id], onDelete: Restrict)
  jobPosting         JobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  reviewer           User?       @relation("ReferralReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  acceptanceReviewer User?       @relation("ReferralAcceptanceReviewer", fields: [acceptanceReviewedById], references: [id], onDelete: Restrict)

  @@index([alumnusId, createdAt])
  @@index([studentId, status, createdAt])
  @@index([departmentIdAtWrite, status, createdAt])
  @@index([jobPostingId])
}

/// Bölüm müfredatı; aynı ders kodu farklı yarıyıllarda kullanılabilir.
model Course {
  id           String             @id @default(uuid(7))
  departmentId String
  code         String
  name         String
  semester     Int
  elective     Boolean
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  department   Department         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  marks        AlumniCourseMark[]

  @@unique([departmentId, code, semester])
  @@index([departmentId, elective, semester])
}

model AlumniCourseMark {
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([userId, courseId])
  @@index([courseId])
}
