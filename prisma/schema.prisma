// Tek doğruluk kaynağı: model, alan, indeks ve ilişki burada; ilkeler docs/data.md'dedir.
// Prisma 7: üretilen istemci `node_modules`'a değil `output` yoluna yazılır (Git dışı);
// bağlantı adresi prisma.config.ts'tedir, istemci driver adapter ile kurulur (src/server/db.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Kurum yapısı (üniversite → fakülte → bölüm) sistem yöneticisinindir.
model University {
  id                  String   @id @default(uuid(7))
  name                String   @unique
  shortName           String   @unique
  /// Öğrenci e-postası alan adları: üniversiteyi doğrular, bölümü doğrulamaz (docs/architecture.md).
  studentEmailDomains String[]
  /// Personel (akademisyen) e-postası alan adları.
  staffEmailDomains   String[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  faculties Faculty[]
}

model Faculty {
  id           String   @id @default(uuid(7))
  universityId String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  university  University   @relation(fields: [universityId], references: [id], onDelete: Restrict)
  departments Department[]
  adminGrants AdminGrant[]

  @@unique([universityId, name])
}

model Department {
  id        String   @id @default(uuid(7))
  facultyId String
  name      String
  /// Kısa kod (örn. YBS); fakülte içinde benzersiz.
  code      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faculty             Faculty              @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  memberships         Membership[]
  adminGrants         AdminGrant[]
  experiences         Experience[]
  graduationDocuments GraduationDocument[]
  events              Event[]

  @@unique([facultyId, code])
  @@unique([facultyId, name])
}

// ---------------------------------------------------------------------------------------------
// Kimlik, üyelik, yetki ve işlem kaydı (P1-01). Prisma'nın ifade edemediği kısıtlar (kısmi benzersizlik,
// CHECK, yalnız-ekleme tetikleyicisi) ham SQL olarak 20261107203050_identity_membership_admin
// migration'ındadır; sözleşme docs/data.md "Temel değişmezler"dedir.
// ---------------------------------------------------------------------------------------------

/// Üyelik rolü. Mentorluk bir rol değil, etkin `MentorProfile`'dır; yönetici yetkisi `AdminGrant`'tır.
enum MembershipRole {
  STUDENT
  ALUMNI
  ACADEMIC
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// Doğrulama yolu (docs/architecture.md "Kimlik ve doğrulama"). Rol ile uyumu veritabanı kısıtıdır:
/// alan adı ile mezun doğrulanamaz, mezun yalnız belge ya da yönetici ile doğrulanır.
enum VerificationMethod {
  STUDENT_EMAIL
  STAFF_EMAIL
  GRADUATION_DOCUMENT
  ADMIN
}

enum AdminScope {
  SYSTEM
  FACULTY
  DEPARTMENT
}

enum MeetingMode {
  ONLINE
  IN_PERSON
}

/// Better Auth kullanıcı tablosu (P1-02 Better Auth'u buna bağlar; `Session`/`Account`/`Verification` orada).
/// Askıya alma alanları admin eklentisinindir: oturumlar düşer, giriş engellenir. Yetki kararı
/// ASLA bu tablodaki bir "rol" alanından verilmez; yetki `Membership` ve `AdminGrant`'tan gelir.
model User {
  id            String    @id @default(uuid(7))
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  phone         String?
  lastSeenAt    DateTime?
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  /// Better Auth admin eklentisinin alanı (eklenti şemasında zorunlu). YETKİ KARARINDA ASLA KULLANILMAZ:
  /// yetki yalnız `Membership` ve `AdminGrant`'tan gelir (davranış testi: `role = 'admin'` yetki vermez).
  role          String?
  /// Hesap silindi (P1-03): satır kalır (işlem kaydı ve ilişkiler için), kişisel alanlar temizlenir.
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships                 Membership[]             @relation("MembershipOwner")
  verifiedMemberships         Membership[]             @relation("MembershipVerifier")
  adminGrants                 AdminGrant[]             @relation("AdminGrantOwner")
  grantedAdminGrants          AdminGrant[]             @relation("AdminGrantGranter")
  revokedAdminGrants          AdminGrant[]             @relation("AdminGrantRevoker")
  mentorProfile               MentorProfile?
  adminAuditLogs              AdminAuditLog[]
  sessions                    Session[]
  accounts                    Account[]
  graduationDocuments         GraduationDocument[]     @relation("GraduationDocumentOwner")
  reviewedGraduationDocuments GraduationDocument[]     @relation("GraduationDocumentReviewer")
  emailLogs                   EmailLog[]
  notificationPreferences     NotificationPreference[]
  notificationActions         NotificationAction[]
  sessionFeedbacks            SessionFeedback[]
  consents                    Consent[]
  fieldVisibilities           FieldVisibility[]
  sentContactRequests         ContactRequest[]         @relation("ContactRequestRequester")
  receivedContactRequests     ContactRequest[]         @relation("ContactRequestTarget")
  profile                     Profile?
  cvUploads                   CvUpload[]
  educations                  Education[]
  positions                   Position[]
  languages                   Language[]
  certifications              Certification[]
  skills                      UserSkill[]
  experienceInvitations       ExperienceInvitation[]

  experiences           Experience[]       @relation("ExperienceAuthor")
  moderatedExperiences  Experience[]       @relation("ExperienceModerator")
  reports               Report[]           @relation("ReportReporter")
  events                Event[]
  availabilityRules     AvailabilityRule[]
  mentorAppointments    Appointment[]      @relation("AppointmentMentor")
  menteeAppointments    Appointment[]      @relation("AppointmentMentee")
  reviewedReports       Report[]           @relation("ReportReviewer")
  cancelledAppointments Appointment[]      @relation("AppointmentCanceller")
}

/// Bildirim türleri; güvenlik bildirimleri daima açıktır.
enum NotificationType {
  ACCOUNT_SECURITY
  GRADUATION_DECISION
  EXPERIENCE_MODERATION
  CONTACT_REQUEST
  CV_INVITATION
  PROFILE_FRESHNESS
  ALUMNI_STILL_THERE
  STUDENT_EMAIL_MIGRATION
  APPOINTMENT
}

enum StillThereChoice {
  YES
  NO
}

/// Tercih yoksa açık kabul edilir; zorunlu güvenlik türü sunucuda kapatılamaz.
model NotificationPreference {
  userId    String
  type      NotificationType
  enabled   Boolean          @default(true)
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
}

/// İmzalı bağlantı sunucuda yeniden üretilebilir; jeton gövdesi saklanmaz.
model NotificationAction {
  id         String            @id @default(uuid(7))
  userId     String
  positionId String
  cycle      String
  expiresAt  DateTime
  usedAt     DateTime?
  choice     StillThereChoice?
  createdAt  DateTime          @default(now())
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  position   Position          @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([userId, positionId, cycle])
  @@index([expiresAt])
}

/// İlk giriş adımı; atlanan ya da tamamlanan adımların kalıcı ilerleme noktası.
enum OnboardingStep {
  MEMBERSHIP
  INTERESTS
  GOALS
  MENTOR_PREFERENCE
  VISIBILITY
  COMPLETE
}

enum TagKind {
  INTEREST
  SKILL
  GOAL
}

/// Kullanıcının kendi profili; kimlik, rol ve yetki kaynağı değildir.
model Profile {
  id                    String           @id @default(uuid(7))
  userId                String           @unique
  headline              String?
  summary               String?
  city                  String?
  goals                 String?
  socialLinks           Json?
  linkedinUrl           String?
  completionScore       Int              @default(0)
  cvUpdatedAt           DateTime?
  lastFreshnessPromptAt DateTime?
  lastStillThereCheckAt DateTime?
  onboardingStep        OnboardingStep   @default(MEMBERSHIP)
  mentorInterested      Boolean?
  /// Adım durumu açıkça tutulur: listede yoksa PENDING. İki liste ayrıktır; MEMBERSHIP ve COMPLETE
  /// atlanamaz (ham SQL CHECK). Atlama veriyi silmez (ilgi/hedef/mentor tercihi olduğu gibi kalır).
  /// Kullanıcının kendi düzenlediği temel alanlar (`headline`/`summary`/`city`); yeni CV bunları sessizce ezmez.
  manualFields          String[]         @default([])
  completedSteps        OnboardingStep[] @default([])
  skippedSteps          OnboardingStep[] @default([])
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags ProfileTag[]
}

/// Sabit sözlük anahtarı; görünen Türkçe karşılık mesaj kataloğundadır.
model Tag {
  id        String   @id @default(uuid(7))
  kind      TagKind
  slug      String
  /// Görünen ad: sabit etiketlerde (ilgi/hedef) boş, metin mesaj kataloğundadır; `SKILL` etiketinde zorunlu
  /// (veritabanı kısıtı). Kullanıcının serbest yazdığı beceri `curated = false` ile açılır ve başkalarına
  /// öneri olarak listelenmez.
  label     String?
  curated   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles ProfileTag[]

  @@unique([kind, slug])
}

model ProfileTag {
  profileId String
  tagId     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([profileId, tagId])
  @@index([tagId])
}

/// Üyelik = kullanıcı × bölüm × rol. Rol geçişinde eski satır `endedAt` ile kapanır, yenisi eklenir;
/// geçmiş korunur. İçerik ve puan `userId`'ye bağlanır, üyeliğe değil (bu yüzden geçişten etkilenmez).
model Membership {
  id                 String             @id @default(uuid(7))
  userId             String
  departmentId       String
  role               MembershipRole
  /// Giriş yılı (öğrenci). Sınıf saklanmaz; `rules/classYear` hesaplar.
  entryYear          Int?
  /// Hazırlık/uzatma düzeltmesi (kullanıcı girer): etkin sınıf = hesaplanan + düzeltme.
  classOffset        Int                @default(0)
  graduationYear     Int?
  verificationStatus VerificationStatus @default(PENDING)
  verificationMethod VerificationMethod
  verifiedAt         DateTime?
  verifiedById       String?
  /// Boşsa üyelik etkindir. Aynı kullanıcı+bölüm+rolde en fazla bir etkin satır olabilir.
  endedAt            DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user       User       @relation("MembershipOwner", fields: [userId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  verifiedBy User?      @relation("MembershipVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([departmentId, verificationStatus])
}

/// Kapsamlı yönetici yetkisi. `SYSTEM`: her şey; `FACULTY`: fakülte ve altındaki bölümler;
/// `DEPARTMENT`: yalnız o bölüm. Kaldırılan yetki silinmez, `revokedAt` ile kapanır.
model AdminGrant {
  id           String     @id @default(uuid(7))
  userId       String
  scope        AdminScope
  facultyId    String?
  departmentId String?
  grantedById  String
  revokedAt    DateTime?
  revokedById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user       User        @relation("AdminGrantOwner", fields: [userId], references: [id], onDelete: Restrict)
  faculty    Faculty?    @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  grantedBy  User        @relation("AdminGrantGranter", fields: [grantedById], references: [id], onDelete: Restrict)
  revokedBy  User?       @relation("AdminGrantRevoker", fields: [revokedById], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([facultyId])
  @@index([departmentId])
}

/// Mentorluk = etkin profil. Kapasite ve görüşme süresi mentorun kararıdır; bu yüzden varsayılan yoktur.
model MentorProfile {
  userId               String        @id
  isActive             Boolean       @default(false)
  monthlyCapacity      Int
  /// 15, 20 ya da 30 dakika (veritabanı kısıtı).
  sessionMinutes       Int
  meetingModes         MeetingMode[]
  inPersonNote         String?
  /// “Müsait değilim”: bu tarihe kadar yeni talep alınmaz.
  pausedUntil          DateTime?
  cvReviewEnabled      Boolean       @default(false)
  cvReviewMonthlyLimit Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

/// Yönetici işlem kaydı (D6). YALNIZ EKLENİR: veritabanı tetikleyicisi güncelleme/silme/TRUNCATE'i
/// reddeder. `metadata` ve `reason` kişisel veri içermez (yalnız kimlikler); `recordAdminAction` doğrular.
model AdminAuditLog {
  id         String   @id @default(uuid(7))
  actorId    String
  action     String
  targetType String
  targetId   String
  reason     String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}

// ---------------------------------------------------------------------------------------------
// Kimlik doğrulama (P1-02 sözleşmesi). Better Auth 1.7 Prisma adaptörünün beklediği alanlar
// (`getAuthTables`: user + admin eklentisi, session, account, verification, rateLimit); sözleşme
// docs/data.md. Ham SQL kısıtlar 20261107205405_auth_contract migration'ındadır.
// ---------------------------------------------------------------------------------------------

/// Veritabanı oturumu. Çerez yalnız jetonu taşır (httpOnly, secure, sameSite=lax). Askıya alma ve hesap
/// silmede oturumlar silinir. `impersonatedBy` admin eklentisinin alanıdır; "başka kullanıcı gibi giriş"
/// KAPALIDIR, bu sütun hep boş kalır.
model Session {
  id             String   @id @default(uuid(7))
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  /// Süresi geçmiş oturum temizliği için (indeks migration'da oluşturulur).
  @@index([expiresAt])
}

/// Dış sağlayıcı bağlantısı (LinkedIn). Giriş parolasızdır; `password` Better Auth şemasında bulunur ama
/// KULLANILMAZ. Jetonlar sağlayıcı tarafına aittir; servis adımı onları şifreli saklar (decisions.md).
model Account {
  id                    String    @id @default(uuid(7))
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

/// Süreli, tek kullanımlık doğrulama kayıtları (e-posta bağlantısı, e-posta değiştirme).
model Verification {
  id         String   @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

/// Better Auth hız sınırı deposu (`rateLimit.storage = "database"`): süreçler arasında ve yeniden
/// başlatmada korunur. `lastRequest` milisaniye damgasıdır.
model RateLimit {
  id          String @id @default(uuid(7))
  key         String @unique
  count       Int
  lastRequest BigInt
}

enum GraduationDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Mezun belgesi (e-Devlet barkodlu PDF) doğrulama kuyruğu. Belge dosyası YALNIZ karar verilene kadar
/// durur: karar anında `storageKey` null olur ve dosya silinir (veritabanı kısıtı). Kuyruk bölümün
/// yöneticisine görünür (`departmentId`). Hedef üyelik (kullanıcı + bölüm, `ALUMNI`) `userId` ve
/// `departmentId` ile bulunur; `Membership`'e yabancı anahtar YOKTUR (şema değişmezi).
model GraduationDocument {
  id             String                   @id @default(uuid(7))
  userId         String
  departmentId   String
  /// Kullanıcının beyan ettiği mezuniyet yılı; onayda `ALUMNI` üyeliğine yazılır.
  graduationYear Int
  /// `graduation/<userId>/<uuid>.pdf`; karar verilmiş satırda null.
  storageKey     String?
  status         GraduationDocumentStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  rejectReason   String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  user       User       @relation("GraduationDocumentOwner", fields: [userId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  reviewedBy User?      @relation("GraduationDocumentReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([departmentId, status, createdAt])
  @@index([userId])
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

/// Giden e-posta kaydı (giden kutusu). GÖVDE ve alıcı adresi SAKLANMAZ: yalnız şablon, alıcı kimliği ve
/// durum. `idempotencyKey` aynı e-postanın ikinci kez gönderilmesini engeller. Saklama 6 ay (docs/data.md).
model EmailLog {
  id              String      @id @default(uuid(7))
  idempotencyKey  String      @unique
  template        String
  /// Kayıtsız adrese giden giriş bağlantısında boştur (kayıtlı olup olmadığı sızmasın diye ayrım yok).
  recipientUserId String?
  status          EmailStatus @default(QUEUED)
  attempts        Int         @default(0)
  errorCode       String?
  sentAt          DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  recipientUser User? @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([recipientUserId])
}

// ---------------------------------------------------------------------------------------------
// KVKK ve kontrollü iletişim (P1-03 sözleşmesi). Kurallar: docs/security.md “KVKK”; görünürlük kararı
// yalnız `src/server/rules/visibility.ts`. Ham SQL kısıtlar 20261108000000_privacy_contract migration'ındadır.
// ---------------------------------------------------------------------------------------------

/// Onaylanan hukuki metin (docs/legal-drafts.md §1–§3).
enum ConsentDocument {
  PRIVACY_NOTICE
  TERMS_OF_USE
  CROSS_BORDER_TRANSFER
}

/// Rıza kaydı: YALNIZ EKLENİR (güncellenmez, silinmez — tetikleyici). Geri çekme yeni satırdır
/// (`granted = false`). Bir belgenin geçerli durumu, o belge için en son satırdır. Hesap silmede kalır
/// (kişisel alan taşımaz; hukuki kanıttır).
model Consent {
  id           String          @id @default(uuid(7))
  userId       String
  documentType ConsentDocument
  /// Metin sürümü (örn. `taslak-1`); güncel sürümle aynı değilse kullanıcı yeniden onaya yönlenir.
  version      String
  granted      Boolean
  createdAt    DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, documentType, createdAt])
}

/// İletişim/kişisel alan (görünürlüğü kullanıcı seçer).
enum ContactField {
  EMAIL
  PHONE
  SOCIAL_LINKS
  LINKEDIN
}

/// `PRIVATE`: yalnız sahibi (yönetici yalnız görev ekranında, maskeli) · `ON_APPROVED_REQUEST`: onaylı
/// iletişim talebi sahibine · `MEMBERS`: doğrulanmış üyelere.
enum VisibilityLevel {
  PRIVATE
  ON_APPROVED_REQUEST
  MEMBERS
}

/// Alan başına görünürlük. Satır yoksa varsayılan geçerlidir (e-posta/telefon `ON_APPROVED_REQUEST`,
/// sosyal/LinkedIn `MEMBERS` — `src/contracts/privacy.ts` `DEFAULT_FIELD_VISIBILITY`).
model FieldVisibility {
  id        String          @id @default(uuid(7))
  userId    String
  field     ContactField
  level     VisibilityLevel
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, field])
}

/// `PENDING` → `APPROVED` | `REJECTED` (hedef karar verir) · `PENDING` → `WITHDRAWN` (talep eden geri çeker)
/// · `APPROVED` → `REVOKED` (hedef istediği an geri alır; alanlar yeniden kapanır).
enum ContactRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  REVOKED
}

/// İletişim talebi: onaylanınca istenen alanlar YALNIZ talep edene açılır (görünürlük kuralı bunu okur).
/// Aynı ikili için aynı anda en fazla bir açık (bekleyen ya da onaylı) talep olur.
model ContactRequest {
  id          String               @id @default(uuid(7))
  requesterId String
  targetId    String
  fields      ContactField[]
  /// İsteğe bağlı kısa not (≤ 500 karakter); hedefe görünür.
  message     String?
  status      ContactRequestStatus @default(PENDING)
  /// Onay ya da ret anı.
  decidedAt   DateTime?
  /// Geri çekme (`WITHDRAWN`) ya da geri alma (`REVOKED`) anı.
  closedAt    DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  requester User @relation("ContactRequestRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  target    User @relation("ContactRequestTarget", fields: [targetId], references: [id], onDelete: Restrict)

  @@index([targetId, status, createdAt])
  @@index([requesterId, status, createdAt])
}

// ---------------------------------------------------------------------------------------------
// CV ayrıştırma hattı (P1-05) — docs/architecture.md "CV ayrıştırma hattı"
// ---------------------------------------------------------------------------------------------

/// `QUEUED` → `PARSING` → `PARSED` (kullanıcı onayını bekler) | `FAILED`; `PARSED` → `APPLIED` | `DISCARDED`.
/// Veritabanı kısıtları: ayrıştırma çıktısı (`parsedJson`) yalnız `PARSED`'dadır; `FAILED` bir `errorCode`
/// taşır; bir kullanıcının en fazla bir işlenen (`QUEUED`/`PARSING`) ve bir onay bekleyen (`PARSED`) CV'si vardır.
enum CvStatus {
  QUEUED
  PARSING
  PARSED
  FAILED
  APPLIED
  DISCARDED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
  FREELANCE
  VOLUNTEER
  OTHER
}

enum EducationLevel {
  HIGH_SCHOOL
  ASSOCIATE
  BACHELOR
  MASTER
  DOCTORATE
  OTHER
}

enum LanguageLevel {
  A1
  A2
  B1
  B2
  C1
  C2
  NATIVE
}

/// Profil kaleminin kaynağı: `CV` (ayrıştırma önerisi kullanıcı onayıyla yazıldı) ya da `MANUAL` (elle).
enum ProfileEntrySource {
  CV
  MANUAL
}

enum DictionaryKind {
  COMPANY
  TITLE
  SKILL
  SECTOR
}

enum ExperienceInvitationStatus {
  OPEN
  DISMISSED
}

/// Yüklenen CV (PDF) ve ayrıştırma durumu. `storageKey`: `cv/<userId>/<uuid>.pdf`; son uygulanan CV'nin dosyası
/// kalır, eski dosyalar uygulama/atma anında silinir (açık incelemeye bağlı dosya hariç), hatada anında silinir.
/// `parsedJson`: doğrulanmış `ParsedCv`, uygulama/atma anında temizlenir; LLM çıktısı yetki belirlemez.
model CvUpload {
  id         String    @id @default(uuid(7))
  userId     String
  storageKey String?
  byteSize   Int
  pageCount  Int
  status     CvStatus  @default(QUEUED)
  parsedJson Json?
  /// `FAILED` için kararlı hata kodu (`ERROR_CODES`).
  errorCode  String?
  /// LLM çağrı denemeleri (iş yeniden denemeleri dahil); yalnız sayaç.
  attempts   Int       @default(0)
  appliedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

/// Sözlükler (sistem yöneticisinin): `normalizedName` benzersiz, `aliases` normalleştirilmiş takma adlar.
/// Eşleme `pg_trgm` benzerliğiyle (eşik `src/server/rules/dictionary.ts`); eşik altı değer `UnmatchedValue`'ya düşer.
model Sector {
  id             String     @id @default(uuid(7))
  name           String
  normalizedName String     @unique
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  companies      Company[]
  positions      Position[]

  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Sector_normalizedName_trgm")
}

model Company {
  id             String     @id @default(uuid(7))
  name           String
  normalizedName String     @unique
  aliases        String[]
  sectorId       String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  sector         Sector?    @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  positions      Position[]

  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Company_normalizedName_trgm")
}

model Title {
  id             String     @id @default(uuid(7))
  name           String
  normalizedName String     @unique
  aliases        String[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  positions      Position[]

  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Title_normalizedName_trgm")
}

model Skill {
  id             String      @id @default(uuid(7))
  name           String
  normalizedName String      @unique
  aliases        String[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  userSkills     UserSkill[]

  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Skill_normalizedName_trgm")
}

/// Sözlükte eşleşmeyen, kullanıcının ONAYLADIĞI değerler (yönetici kuyruğu). Kişi bilgisi tutmaz: yalnız değer,
/// normalleştirilmiş hali ve kaç kez görüldüğü. `resolvedToId`: yönetici sözlük kaydına bağladıysa onun kimliği.
model UnmatchedValue {
  id              String         @id @default(uuid(7))
  kind            DictionaryKind
  rawValue        String
  normalizedValue String
  count           Int            @default(1)
  resolvedToId    String?
  /// Yönetici değeri anlamsız bulup kuyruktan düşürdü (P1-11). Aynı değer yeniden gelirse sayaç artar, kuyruk
  /// yeniden AÇILMAZ. Durum: açık = ikisi de boş; çözüldü = `resolvedToId`; atıldı = `dismissedAt`.
  dismissedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([kind, normalizedValue])
  @@index([kind, count])
}

/// Profil kalemleri (P1-06 ekranı gösterir/düzenler). Kullanıcıya bağlıdır (üyeliğe değil). `manuallyEdited`
/// (ya da `source = MANUAL`) kalem yeni CV ile SESSİZCE ezilmez: çakışma olarak ayrı gösterilir.
model Education {
  id             String             @id @default(uuid(7))
  userId         String
  institution    String
  level          EducationLevel?
  fieldOfStudy   String?
  startYear      Int?
  startMonth     Int?
  endYear        Int?
  endMonth       Int?
  isCurrent      Boolean            @default(false)
  source         ProfileEntrySource
  manuallyEdited Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Position {
  id             String             @id @default(uuid(7))
  userId         String
  companyId      String?
  companyRaw     String
  titleId        String?
  titleRaw       String
  sectorId       String?
  employmentType EmploymentType?
  startYear      Int?
  startMonth     Int?
  endYear        Int?
  endMonth       Int?
  isCurrent      Boolean            @default(false)
  description    String?
  source         ProfileEntrySource
  manuallyEdited Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  company             Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  title               Title?                @relation(fields: [titleId], references: [id], onDelete: SetNull)
  sector              Sector?               @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  invitation          ExperienceInvitation?
  notificationActions NotificationAction[]

  @@index([userId])
}

model Language {
  id             String             @id @default(uuid(7))
  userId         String
  name           String
  normalizedName String
  level          LanguageLevel?
  source         ProfileEntrySource
  manuallyEdited Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedName])
}

model Certification {
  id             String             @id @default(uuid(7))
  userId         String
  name           String
  issuer         String?
  issuedYear     Int?
  issuedMonth    Int?
  source         ProfileEntrySource
  manuallyEdited Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// ESKİ (P1-06 ile bırakıldı): beceriler artık `Tag(SKILL)` + `ProfileTag`'tir. Veri taşındı; tablo ekleyici
/// politikası gereği bir sonraki daraltma migration'ında kaldırılır (BACKLOG TD-013).
model UserSkill {
  id             String             @id @default(uuid(7))
  userId         String
  skillId        String?
  name           String
  normalizedName String
  source         ProfileEntrySource
  manuallyEdited Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill? @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@unique([userId, normalizedName])
}

/// CV'den gelen her staj pozisyonu için "bu stajı yazmak ister misin?" daveti (P1-07 deneyimi bağlar).
/// Pozisyon başına en fazla bir davet; deneyim tablosu gelene kadar yazılmış deneyim yoktur.
model ExperienceInvitation {
  id         String                     @id @default(uuid(7))
  userId     String
  positionId String                     @unique
  status     ExperienceInvitationStatus @default(OPEN)
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// P1-07: tür bazlı deneyim ve şikâyet sözleşmesi. Yayın/erişim iş mantığı servis kartındadır.
enum ExperienceType {
  INTERNSHIP
  ERASMUS
  COMPETITION
  HACKATHON
  CLUB
  CERTIFICATE
  GRADUATE_STUDY
  STUDY_ABROAD
}

enum ExperienceStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
}

enum TermSeason {
  SPRING
  SUMMER
  AUTUMN
  WINTER
}

enum ExperiencePay {
  PAID
  UNPAID
  NOT_DISCLOSED
}

enum ApplicationChannel {
  LINKEDIN_POST
  CAREER_PLATFORM
  COMPANY_SITE
  REFERRAL
  CAREER_FAIR
  COLD_EMAIL
  UNIVERSITY_ANNOUNCEMENT
  OTHER
}

enum ReportTargetType {
  EXPERIENCE
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// Taslak eksik olabilir; PENDING/PUBLISHED/REJECTED içerik tür şablonunu tamamlamış olmalıdır.
/// Anonimlik çıktı sınırıdır: authorId sahiplik/hesap silme için depoda kalır, hiçbir anonim çıktıya girmez.
model Experience {
  id                  String                   @id @default(uuid(7))
  authorId            String?
  /// Yazım anındaki doğrulanmış üyelikten; sonradan rol/bölüm değişimi moderasyon kapsamını değiştirmez.
  departmentIdAtWrite String
  type                ExperienceType
  /// Company sözlüğü P1-05'te vardır; deneyim FK bağlantısı P1-08'de eklenir.
  companyId           String?
  organizationName    String?
  country             String?
  city                String?
  termYear            Int?
  termSeason          TermSeason?
  durationWeeks       Int?
  pay                 ExperiencePay?
  applicationChannel  ApplicationChannel?
  processSteps        Json                     @default("[]")
  interviewQuestions  String[]                 @default([])
  whatLearned         String                   @default("")
  advice              String                   @default("")
  isAnonymous         Boolean                  @default(false)
  status              ExperienceStatus         @default(DRAFT)
  moderationNote      String?
  moderatedById       String?
  moderatedAt         DateTime?
  publishedAt         DateTime?
  /// Üretilmiş arama sütunları (GENERATED ALWAYS; P1-08 ham SQL migration'ı). Prisma yazamaz; istemcide global `omit`
  /// ile hiçbir sorguda varsayılan dönmez (`src/server/db.ts`). Yalnız `repositories/search.ts` ham SQL ile okur.
  /// `dbgenerated()` ve aşağıdaki GIN indeksleri `migrate dev`'in yanlış ALTER/DROP üretmesini önler (docs/decisions.md).
  searchVector        Unsupported("tsvector")? @default(dbgenerated())
  searchKeys          String?                  @default(dbgenerated())
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  author      User?      @relation("ExperienceAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  department  Department @relation(fields: [departmentIdAtWrite], references: [id], onDelete: Restrict)
  moderatedBy User?      @relation("ExperienceModerator", fields: [moderatedById], references: [id], onDelete: Restrict)
  reports     Report[]

  @@index([authorId, updatedAt])
  @@index([departmentIdAtWrite, status, createdAt])
  @@index([status, publishedAt])
  @@index([type, termYear])
  @@index([searchVector], type: Gin, map: "Experience_searchVector_idx")
  @@index([searchKeys(ops: raw("gin_trgm_ops"))], type: Gin, map: "Experience_searchKeys_trgm")
}

/// Şimdilik tek hedef türü deneyimdir; hedef FK ile korunur. SSS kendi sözleşmesinde eklenir.
/// Raportör kimliği hiçbir çıktı şemasında yoktur; hesap silmede koparılabilir.
model Report {
  id             String           @id @default(uuid(7))
  targetType     ReportTargetType @default(EXPERIENCE)
  targetId       String
  reporterId     String?
  reason         String
  status         ReportStatus     @default(OPEN)
  reviewedById   String?
  reviewedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  target     Experience @relation(fields: [targetId], references: [id], onDelete: Cascade)
  reporter   User?      @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reviewedBy User?      @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([targetId, status])
  @@index([status, createdAt])
  @@index([reporterId])
}

enum EventType {
  LOGIN
  PROFILE_THRESHOLD
  CV_UPLOADED
  CV_APPLIED
  EXPERIENCE_PUBLISHED
  SEARCH
  MENTOR_SEARCH
  MENTOR_VIEWED
  APPOINTMENT_REQUESTED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_COMPLETED
  FAQ_REQUESTED
  FAQ_PUBLISHED
  CV_REVIEW_REQUESTED
  CONTACT_REQUESTED
}

/// Kullanım metrikleri (P1-13). `props` KİŞİSEL VERİ taşımaz (Zod strict + veritabanı CHECK). `role` ve `departmentId`
/// olay anındaki üyelik anlık görüntüsüdür. `userId` 24 ay sonra ve hesap silmede `null` yapılır; sayılar kalır.
model Event {
  id           String          @id @default(uuid(7))
  type         EventType
  userId       String?
  role         MembershipRole?
  departmentId String?
  props        Json            @default("{}")
  createdAt    DateTime        @default(now())

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@index([type, createdAt])
  @@index([departmentId, createdAt])
  @@index([userId, createdAt])
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  CANCELLED
  EXPIRED
  COMPLETED
  NO_SHOW
}

/// Mentorun haftalık müsaitliği (P1-10). `weekday` 1 = pazartesi … 7 = pazar; dakikalar `Europe/Istanbul` yerel günüdür.
/// `mode` boşsa iki biçim de. Aynı mentor+gün aralıkları çakışamaz (exclusion, ham SQL migration).
model AvailabilityRule {
  id          String       @id @default(uuid(7))
  mentorId    String
  weekday     Int
  startMinute Int
  endMinute   Int
  mode        MeetingMode?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  mentor User @relation(fields: [mentorId], references: [id], onDelete: Restrict)

  @@index([mentorId, weekday])
}

/// Randevu (P1-10). Aynı mentorun REQUESTED/CONFIRMED aralıkları ve aynı öğrencinin REQUESTED/CONFIRMED aralıkları
/// çakışamaz (exclusion constraint, ham SQL migration): çakışmanın son sözü veritabanıdır. `expiresAt` yalnız REQUESTED
/// için anlamlıdır (D11). Hesap silmede açık randevular iptal edilir ve notlar temizlenir (satır kalır).
model Appointment {
  id                String            @id @default(uuid(7))
  mentorId          String
  menteeId          String
  startsAt          DateTime
  endsAt            DateTime
  mode              MeetingMode
  menteeNote        String?
  /// Yüz yüze: onayda mentorun yer notundan kopyalanır (sonradan değişen ayar randevuyu değiştirmez).
  location          String?
  status            AppointmentStatus @default(REQUESTED)
  expiresAt         DateTime
  decidedAt         DateTime?
  decisionNote      String?
  meetUrl           String?
  calendarEventId   String?
  /// Takvim etkinliği oluşturma kesin başarısız oldu (ya da adaptör kapalı): mentor elle link ekler.
  calendarFailedAt  DateTime?
  /// Takvim etkinliği oluşturma deneme sayısı (en çok 3; sonra mentor elle link ekler).
  calendarAttempts  Int               @default(0)
  reminderSentAt    DateTime?
  cancelledById     String?
  cancelledBySystem Boolean           @default(false)
  cancelReason      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  mentor      User              @relation("AppointmentMentor", fields: [mentorId], references: [id], onDelete: Restrict)
  mentee      User              @relation("AppointmentMentee", fields: [menteeId], references: [id], onDelete: Restrict)
  cancelledBy User?             @relation("AppointmentCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  feedbacks   SessionFeedback[]

  @@index([mentorId, status, startsAt])
  @@index([menteeId, status, startsAt])
  @@index([status, expiresAt])
}

/// Görüşme sonu yanıtı: her katılımcı aynı randevu için yalnız bir kez yanıtlar.
model SessionFeedback {
  id            String      @id @default(uuid(7))
  appointmentId String
  authorId      String
  happened      Boolean
  helpful       Boolean?
  note          String?
  createdAt     DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  author        User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, authorId])
  @@index([authorId, createdAt])
}
