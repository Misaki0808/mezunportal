{
  "name": "mezunportal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test scripts/*.test.mjs && vitest run --maxWorkers=2",
    "messages:check": "node scripts/check-messages.mjs",
    "test:unit": "vitest run --maxWorkers=2 --project unit",
    "test:gate": "node scripts/test-gate.mjs",
    "test:perf": "PERF=1 vitest run --maxWorkers=1 --project perf",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "test:e2e": "playwright test",
    "evidence": "node scripts/evidence.mjs",
    "dev:all": "node scripts/dev.mjs all",
    "dev:lan": "node scripts/dev.mjs lan",
    "test:local": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "^1.7.18",
    "exceljs": "^4.4.0",
    "next": "^16.4.5",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "pg-boss": "12.38.1",
    "prisma": "7.10.1",
    "qr": "0.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "unpdf": "2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  }
}
