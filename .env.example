# MezunPortal ortam değişkenleri — kanonik doğrulama: src/lib/env.ts
# Gerçek değerler `.env.local`'da (Git dışı) ve `korunan/`'dadır; bu dosyaya sır yazılmaz.

# Çalışma ortamı: local | test | prod
APP_ENV=local
# Uygulamanın dışarıdan görünen adresi; dev/dev:all/dev:lan portu buradan okur.
# worktree-env.sh worktree rol diliminden seçer; dev:lan dosyayı değiştirmez.
APP_URL=http://localhost:3000
# Derleme anındaki commit; yerelde boş bırakılır (/api/health "local" döner)
GIT_SHA=

# Uygulama veritabanı — worktree başına `mezun_<worktree-adı>` (tire yerine alt çizgi).
# Kimlik bilgisi yalnız 127.0.0.1'e bağlı yerel Docker konteynerine aittir (docker-compose.yml).
DATABASE_URL=postgresql://mezun:mezun@127.0.0.1:5432/mezun_ornek
# Yalnız veritabanlı testler için; adı MUTLAKA `_test` ile biter (testler başlamadan bu veritabanını sıfırlar)
DATABASE_URL_TEST=postgresql://mezun:mezun@127.0.0.1:5432/mezun_ornek_test

# --- Kimlik doğrulama ve e-posta (yalnız giriş kodu okur; /api/health bunlara bağlı değildir) ---
# Oturum/jeton imza sırrı (≥ 32 karakter). Aşağıdaki GENEL geliştirme değeri yalnız local/test'te kabul edilir;
# APP_ENV=prod ile "dev-only" başlayan değer env doğrulamasını düşürür. Canlı için: openssl rand -base64 48
BETTER_AUTH_SECRET=dev-only-insecure-secret-for-local-and-test-0000
# SMTP: yerelde Mailpit (docker-compose.yml). Hiçbir e-posta gerçek adrese gitmez.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# true ise TLS (465); Mailpit için false/boş
SMTP_SECURE=false
# Kimlik doğrulamalı SMTP için ikisi birlikte; Mailpit için boş bırak
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=MezunPortal <no-reply@test.mezunportal.local>
# LinkedIn ile giriş İSTEĞE BAĞLI: ikisi de boşsa sağlayıcı kapalıdır. Uygulama ve doğrulanmış şirket sayfası kullanıcıda.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Dosya depolama (mezun belgesi) ---
# Yerel sürücü; Git dışı .data/ altında, worktree başına. Boş bırakılırsa varsayılanlar geçerlidir.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=.data/files

# --- CV ayrıştırma (LLM) ---
# LLM_PROVIDER boşsa CV ayrıştırma KAPALIDIR (elle giriş açık kalır). `fake`: deterministik sahte adaptör,
# yalnız local/test (canlıda reddedilir). Gerçek sağlayıcı (K-04) seçilince LLM_API_KEY ve LLM_MODEL burada okunur.
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=
# Kullanıcı başına günlük ayrıştırma sınırı (1-50)
CV_PARSE_DAILY_LIMIT=5

# --- Takvim / Meet (randevu) ---
# CALENDAR_PROVIDER boşsa takvim KAPALIDIR: online randevu yine onaylanır, mentor görüşme linkini elle ekler.
# `fake`: deterministik sahte adaptör, yalnız local/test (canlıda reddedilir). Gerçek Google adaptörü (E4) ayrı kartla gelir.
CALENDAR_PROVIDER=fake
